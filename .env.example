# Copia este archivo como .env y completa los valores reales.
# Todas son públicas: terminan en el HTML/JS del navegador. Nunca pongas secretos aquí.

# Número de WhatsApp con código de país, sin "+" ni espacios (ej. 51987654321)
PUBLIC_WHATSAPP_NUMBER=51XXXXXXXXX

# ID del proyecto de Microsoft Clarity (solo se carga si la persona acepta cookies)
PUBLIC_CLARITY_ID=yussnspsw6

# URL base de la API (repo depahost-api). Vacío = el sitio usa src/content/properties.json
# y los formularios muestran WhatsApp como alternativa.
#   Mock local:  pnpm api:mock  →  http://127.0.0.1:4010
#   API local:   http://127.0.0.1:3000
PUBLIC_API_URL=

# Cloudflare Turnstile (anti-spam). Clave de prueba que siempre pasa: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# Sentry para errores del navegador (opcional)
PUBLIC_SENTRY_DSN=

# Dominio desde el que se sirven las fotos de la API (Cloudflare R2), para optimizarlas con <Picture>
PUBLIC_MEDIA_HOST=
