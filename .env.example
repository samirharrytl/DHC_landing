# Desarrollo local. Copia este archivo como .env.
# Los otros entornos: .env.preprod.example (preproducción local) y .env.production.example.
# Todas son públicas: terminan en el HTML/JS del navegador. Nunca pongas secretos aquí.

# Número de WhatsApp con código de país, sin "+" ni espacios (ej. 51987654321)
PUBLIC_WHATSAPP_NUMBER=51XXXXXXXXX

# ID del proyecto de Microsoft Clarity (solo se carga si la persona acepta cookies).
# Vacío en local: así las visitas de prueba no se mezclan con las estadísticas reales.
PUBLIC_CLARITY_ID=

# URL base de la API a la que el navegador envía formularios y cuentas (repo depahost-api: pnpm dev).
# Vacío = los formularios muestran WhatsApp como alternativa.
#   Mock sin base de datos:  pnpm api:mock  →  http://127.0.0.1:4010
PUBLIC_API_URL=http://localhost:3000

# URL de la API de la que el BUILD lee depas, inmobiliarias y supuestos (no llega al navegador).
# Vacío = usa src/content/*.json, con las fotos del repo: el sitio funciona sin el API corriendo.
# Con http://localhost:3000, astro dev y el build leen la base local y necesitan el API encendido.
API_URL=

# Panel de cuentas (repo depahost-panel). Vacío = no se muestra "Ingresar".
# Usa "localhost" (no 127.0.0.1) en todas las URLs locales: así la cookie de sesión se comparte.
PUBLIC_PANEL_URL=http://localhost:5173

# Cloudflare Turnstile (anti-spam). Vacío en desarrollo.
# Clave de prueba que siempre pasa: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# Sentry para errores del navegador (opcional)
PUBLIC_SENTRY_DSN=

# Dominio desde el que se sirven las fotos de la API (Cloudflare R2), para optimizarlas con <Picture>
PUBLIC_MEDIA_HOST=
