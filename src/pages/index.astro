---
import { Picture } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Button from '../components/Button.astro'
import OwnerDropdown from '../components/OwnerDropdown.astro'
import heroImage from '../assets/hero-home.jpg'

// Las 3 tarjetas de servicios. icon = nombre del dibujo que se muestra a la izquierda
const servicios = [
  {
    title: 'Reservar estadía',
    href: '/estadias',
    icon: 'cama',
    text: 'Encuentra y reserva tu estadía ideal en Lima.',
  },
  {
    title: 'Propietarios: vende o ponlo en alquiler',
    href: '/propietarios',
    icon: 'casa',
    text: 'Te ayudamos a vender tu propiedad o ponerla en alquiler con el enfoque correcto.',
  },
  {
    title: 'Capital: compra para que rinda',
    href: '/capital',
    icon: 'grafico',
    text: 'Invierte en inmuebles en Lima para rentabilizar, hasta 3 opciones a tu medida.',
  },
]
---

<BaseLayout title="Inicio">
  <!-- ---------- Hero ---------- -->
  <section class="hero" data-hero>
    <div class="hero-media">
      <Picture
        src={heroImage}
        alt="Sala de un inmueble en Lima con vista al mar"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        quality={70}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="container hero-content">
      <div class="hero-text">
        <!-- {' '} deja un espacio para cuando el salto de línea está oculto (móvil) -->
        <h1>
          El inmueble en Lima, <br class="br-sm" />
          con la decisión correcta.
        </h1>
        <p class="lead">Reserva. Vende. Ponlo en alquiler. O cómpralo para que rinda.</p>

        <div class="btn-group ctas">
          <Button href="/estadias">Reservar estadía</Button>
          <OwnerDropdown />
          <Button href="/capital">Comprar para rentabilizar</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- Servicios ---------- -->
  <section class="container features" aria-labelledby="servicios-title">
    <!-- Título solo para lectores de pantalla: mantiene el orden h1 → h2 → h3 -->
    <h2 id="servicios-title" class="sr-only">
      Servicios
    </h2>
    {servicios.map((s) => (
      <article class="feature">
        <svg
          class="feature-icon"
          viewBox="0 0 40 40"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {s.icon === 'cama' && (
            <path d="M5 31V11M5 25h30v6M35 25v-4a5 5 0 0 0-5-5H18v9M11.5 22.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
          )}
          {s.icon === 'casa' && <path d="M6 18 20 7l14 11M10 15v18h20V15M17 33v-8h6v8" />}
          {s.icon === 'grafico' && <path d="M6 33h28M8 27l8-8 6 5 10-11M26 13h6v6" />}
        </svg>
        <div>
          <h3>
            <a href={s.href}>{s.title}</a>
          </h3>
          <p>{s.text}</p>
          <span class="more" aria-hidden="true">
            Ver más →
          </span>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  /* Móvil/tablet: primero el texto, después la imagen */
  .hero {
    display: flex;
    flex-direction: column;
  }
  .hero-content {
    order: 1;
    padding-block: var(--space-8) var(--space-6);
  }
  .hero-media {
    order: 2;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(120deg, var(--color-navy-50), var(--color-navy-100) 60%, #c9d4e5);
  }
  /* La foto (astro:assets genera un <picture>) llena el marco y recorta sin deformar */
  .hero-media :global(picture) {
    position: absolute;
    inset: 0;
  }
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .br-sm {
    display: none;
  } /* el salto de línea del título solo desde 640px */
  .ctas {
    margin-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .br-sm {
      display: inline;
    }
    .hero-media {
      aspect-ratio: 16 / 9;
    }
  }

  /* Escritorio: la imagen ocupa todo el fondo y el texto va encima a la izquierda */
  @media (min-width: 1024px) {
    .hero {
      position: relative;
      display: grid;
      align-items: center;
      min-height: clamp(440px, 62vh, 600px);
    }
    .hero-media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
    /* Degradado blanco para que el texto se lea bien sobre la foto */
    .hero-media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgb(255 255 255 / 0.94) 0%,
        rgb(255 255 255 / 0.8) 38%,
        rgb(255 255 255 / 0) 62%
      );
    }
    .hero-content {
      position: relative;
      padding-block: var(--space-12) var(--space-20);
    }
    .hero-text h1,
    .hero-text .lead {
      max-width: 36rem;
    }
    .ctas {
      flex-wrap: nowrap;
    } /* los 3 botones en una sola fila */
  }

  /* ---------- Tarjetas de servicios ---------- */
  .features {
    position: relative; /* queda encima del hero cuando se superponen */
    display: grid;
    gap: var(--grid-gap);
    margin-top: var(--space-8);
  }
  .feature {
    position: relative;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    background: #fff;
    border: var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .feature:hover {
    border-color: var(--color-navy-800);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .feature:has(a:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    color: var(--color-navy-800);
  }
  .feature h3 a {
    color: inherit;
    text-decoration: none;
  }
  .feature h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  } /* toda la tarjeta es clicable */
  .feature h3 a:focus-visible {
    box-shadow: none;
  }
  .feature p {
    margin: var(--space-2) 0 0;
  }
  .more {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-navy-800);
  }

  @media (min-width: 1024px) {
    .features {
      grid-template-columns: repeat(3, 1fr);
      margin-top: calc(-1 * var(--space-12)); /* se montan 48px sobre el hero */
    }
    .feature {
      padding: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature:hover {
      transform: none;
    }
  }
</style>
