---
// Detalle de un inmueble. Una página estática por inmueble, generada en el build desde getProperties().
// Arriba, el título (la calle) y dónde queda. Debajo, en escritorio, dos columnas: a la izquierda las fotos y la
// descripción; a la derecha la ficha: primero el precio y lo que rinde, después cómo es y al final cómo seguir.
// Cada dato aparece una sola vez.
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import FactRow from '../../components/FactRow.astro'
import Icon from '../../components/Icon.astro'
import PropertyGallery from '../../components/PropertyGallery.astro'
import SaveButton from '../../components/SaveButton.astro'
import { propertyFacts, type Fact } from '../../lib/facts'
import { formatMoney, formatYield, streetOf } from '../../lib/format'
import { getProperties } from '../../lib/properties'
import type { Property } from '../../types/property'

export const getStaticPaths = (async () => {
  const properties = await getProperties()
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }))
}) satisfies GetStaticPaths

interface Props {
  property: Property
}

const { property: p } = Astro.props
// Como en la tarjeta, resalta la calle; debajo va el resto de la dirección y el distrito: "Cuadra 12, Lince"
const street = streetOf(p.address)
const block = p.address.slice(street.length).trim()
const location = [block.charAt(0).toUpperCase() + block.slice(1), p.district.name].filter(Boolean).join(', ')
const name = `${street}, ${p.district.name}`
const isProject = p.origin === 'developer'
const statusLabel = { published: 'Disponible', reserved: 'Reservado', sold: 'Vendido' }[p.status]
const price = formatMoney(p.price.amount, p.price.currency)
const facts = propertyFacts(p)
// Lo que rinde, debajo del precio, con el mismo formato que los datos del inmueble. Por ahora sin el
// alquiler mensual estimado (formatMonthlyRent)
const returns: Fact[] = [
  {
    parts: [{ icon: 'trend', value: formatYield(p.yield).replace(' anual', '') }],
    label: 'rentabilidad anual',
    positive: true,
  },
]

// Datos estructurados para Google (schema.org)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Inmueble en ${p.district.name}, ${p.address}`,
  description: p.description ?? `Inmueble para invertir en ${p.district.name}, Lima.`,
  offers: {
    '@type': 'Offer',
    price: p.price.amount,
    priceCurrency: p.price.currency,
    availability: p.status === 'published' ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut',
  },
}
---

<BaseLayout
  title={name}
  description={`Inmueble en ${p.district.name} desde ${price}. Rentabilidad ${formatYield(p.yield)}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="container detail" data-property-id={p.id}>
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/capital">Capital</a>
      {p.developer && (
        <>
          <span aria-hidden="true">›</span>
          <a href={`/capital/aliados/${p.developer.slug}`}>{p.developer.name}</a>
        </>
      )}
      <span aria-hidden="true">›</span>
      <span aria-current="page">{p.district.name}</span>
    </nav>

    <!-- Título arriba de todo: así la ficha empieza por el precio -->
    <header class="detail-head">
      <p class="eyebrow">
        {isProject ? 'De proyecto' : 'De propietario'}
        {p.developer && (
          <>
            <span aria-hidden="true">·</span>
            <a href={`/capital/aliados/${p.developer.slug}`}>{p.developer.name}</a>
          </>
        )}
      </p>
      <h1 class="display">{street}</h1>
      <p class="location">
        <Icon name="pin" size={18} />
        {location}
      </p>
    </header>

    <div class="detail-layout">
      <div class="detail-media">
        <PropertyGallery images={p.images} videos={p.videos} title={name} />
      </div>

      <!-- ---------- Ficha: precio y lo que rinde · cómo es · cómo seguir ---------- -->
      <div class="detail-side">
        <div class="sheet">
          <div class="money">
            <div>
              <div class="price-head">
                <p class="price-label">{isProject ? 'Precio desde' : 'Precio de compra'}</p>
                <p class:list={['status', `is-${p.status}`]}>{statusLabel}</p>
              </div>
              <p class="price">
                {price}
                {p.badge && p.status === 'published' && <span class="deal">{p.badge}</span>}
              </p>
            </div>
            <FactRow facts={returns} label="Rentabilidad" />
          </div>

          <FactRow facts={facts} label="Características" />

          <div class="next">
            <div class="buy-actions">
              {p.status !== 'sold' && <SaveButton id={p.id} name={name} class="btn--block" />}
              <a class="btn btn--primary btn--sm btn--block" href={`/mis-inmuebles?agregar=${p.id}`}>
                <Icon name="mail" size={18} />
                Contactar
              </a>
            </div>
            <ul class="trust">
              <li>
                <Icon name="handshake" size={18} />
                Te acompañamos hasta la firma
              </li>
              <li>
                <Icon name="calendar" size={18} />
                Coordinamos la visita contigo
              </li>
              <li>
                <Icon name="shield" size={18} />
                Cierras directo con {isProject ? 'la inmobiliaria' : 'el propietario'}
              </li>
            </ul>
          </div>
        </div>
      </div>

      {p.description && (
        <section class="about" aria-labelledby="about-title">
          <h2 id="about-title">Sobre este inmueble</h2>
          <p class="description">{p.description}</p>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<script>
  import { getHistoryStore } from '../../lib/saved-store'

  // Guarda la visita para "Para ti, según lo que has visto"
  const id = document.querySelector<HTMLElement>('[data-property-id]')?.dataset.propertyId
  if (id) getHistoryStore().touch(id)
</script>

<style>
  .detail {
    padding-block: var(--space-4) var(--space-12);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .breadcrumb a {
    color: var(--color-navy-800);
  }

  /* ---------- Título: tipo, calle y distrito ---------- */
  .detail-head {
    margin-bottom: var(--space-5);
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .eyebrow a {
    color: inherit;
  }
  h1 {
    margin-top: var(--space-2);
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.375rem);
    color: var(--color-navy-800);
  }
  .location {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }
  .location :global(svg) {
    flex: none;
  }

  /* ---------- Distribución ---------- */
  /* Celular y tablet: una columna, en orden fotos → ficha → descripción */
  .detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'media' 'side' 'about';
    gap: var(--space-6);
  }
  .detail-media {
    grid-area: media;
    min-width: 0;
  }
  .detail-side {
    grid-area: side;
    min-width: 0;
  }
  .about {
    grid-area: about;
  }

  /* ---------- Ficha ---------- */
  /* Tres bloques separados por aire: el precio con lo que rinde, cómo es (dormitorios, área, antigüedad) y
     cómo seguir. Las dos filas de datos tienen la misma forma que en la tarjeta */
  .sheet {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-5);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-sm);
    container-type: inline-size; /* las filas de datos y los botones se acomodan si la ficha es angosta */
  }
  .money {
    display: grid;
    gap: var(--space-3);
  }

  /* Precio: lo primero y lo más grande. A su altura, si está disponible */
  .price-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }
  .price-label {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .status {
    display: inline-flex;
    margin: 0;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  .status.is-published {
    color: var(--color-success);
  }
  .status.is-reserved {
    color: #b25e09;
  }
  .status.is-sold {
    color: var(--color-error);
  }
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-1) 0 0;
    color: var(--color-text-strong);
    font-size: clamp(1.875rem, 1.5rem + 1.2vw, 2.375rem);
    font-weight: var(--fw-bold);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  /* "Súper precio": la misma insignia que en la foto de la tarjeta, junto al precio que califica */
  .deal {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-deal);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    line-height: 1.4;
    text-transform: uppercase;
  }
  .note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--fs-13);
    color: var(--color-text-muted);
  }
  .note :global(svg) {
    flex: none;
  }

  /* Cómo seguir */
  .next {
    display: grid;
    gap: var(--space-4);
  }
  .buy-actions {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: var(--space-2);
  }
  .buy-actions > :global(*) {
    min-height: var(--control-h-md);
    border-radius: var(--radius-pill);
  }
  /* Ficha angosta (celulares): un botón debajo del otro */
  @container (max-width: 339px) {
    .buy-actions {
      grid-auto-flow: row;
    }
  }
  .trust {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-13);
    color: var(--color-text);
  }
  .trust li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .trust :global(svg) {
    flex: none;
    color: var(--color-navy-800);
  }

  /* ---------- Sobre este inmueble ---------- */
  .about h2 {
    font-size: var(--fs-18);
    letter-spacing: 0;
  }
  .description {
    max-width: 70ch;
    margin: var(--space-2) 0 0;
    white-space: pre-line;
  }

  @media (min-width: 640px) {
    .sheet {
      gap: var(--space-8);
      padding: var(--space-6);
    }
  }
  /* Escritorio: fotos y descripción a la izquierda; a la derecha la ficha (ocupa las dos filas) */
  @media (min-width: 1024px) {
    .detail-layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'media side'
        'about side';
      gap: var(--space-8) var(--space-10);
    }
    .detail-media,
    .about {
      align-self: start;
    }
  }
  /* La ficha (unos 550px) acompaña al bajar por la descripción si entra entera bajo el header: desde
     laptops de 768px de alto. En pantallas más bajas taparía los botones */
  @media (min-width: 1024px) and (min-height: 720px) {
    .sheet {
      position: sticky;
      top: calc(var(--header-h) + var(--space-4));
    }
  }
</style>
