---
// Detalle de un inmueble. Una página estática por inmueble, generada en el build desde getProperties().
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Icon from '../../components/Icon.astro'
import MiniCard from '../../components/MiniCard.astro'
import PropertyGallery from '../../components/PropertyGallery.astro'
import SaveButton from '../../components/SaveButton.astro'
import {
  getDevelopers,
  getFinancingAssumptions,
  getProperties,
  getSimilarProperties,
} from '../../lib/properties'
import { buildDisclaimer, formatFacts, formatMoney, formatYears, formatYield } from '../../lib/format'
import type { Property } from '../../types/property'

export const getStaticPaths = (async () => {
  const properties = await getProperties()
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }))
}) satisfies GetStaticPaths

interface Props {
  property: Property
}

const { property: p } = Astro.props
const street = p.address.replace(/ cuadra \d+$/i, '')
const title = `${p.district.name} · ${street}`
const isProject = p.origin === 'developer'
const statusLabel = { published: 'Disponible', reserved: 'Reservado', sold: 'Vendido' }[p.status]
const price = formatMoney(p.price.amount, p.price.currency)
const facts = formatFacts(p)
const disclaimer = buildDisclaimer(await getFinancingAssumptions())
const similar = await getSimilarProperties(p, 4)
const developerId = p.developer?.id
const developer =
  developerId === undefined ? undefined : (await getDevelopers()).find((d) => d.id === developerId)

const stats = [
  {
    icon: 'money' as const,
    label: 'valor',
    value: price,
    note: isProject ? 'Precio desde' : 'Precio de compra',
  },
  {
    icon: 'trend' as const,
    label: 'rentabilidad',
    value: formatYield(p.yield),
    note: 'Estimada',
    positive: true,
  },
  {
    icon: 'calendar' as const,
    label: 'se paga en',
    value: formatYears(p.paybackYears),
    note: 'Plazo de inversión',
  },
]

// Datos estructurados para Google (schema.org)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Inmueble en ${p.district.name}, ${p.address}`,
  description: p.description ?? `Inmueble para invertir en ${p.district.name}, Lima.`,
  offers: {
    '@type': 'Offer',
    price: p.price.amount,
    priceCurrency: p.price.currency,
    availability: p.status === 'published' ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut',
  },
}
---

<BaseLayout
  title={title}
  description={`Inmueble en ${p.district.name} desde ${price}. Rentabilidad ${formatYield(p.yield)}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="container detail" data-property-id={p.id}>
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/capital">Capital</a>
      {p.developer && (
        <>
          <span aria-hidden="true">›</span>
          <a href={`/capital/aliados/${p.developer.slug}`}>{p.developer.name}</a>
        </>
      )}
      <span aria-hidden="true">›</span>
      <span aria-current="page">{p.district.name}</span>
    </nav>

    <div class="detail-top">
      <PropertyGallery
        images={p.images}
        videos={p.videos}
        title={title}
        tag={isProject ? 'De proyecto' : 'De propietario'}
      />

      <div class="detail-info">
        <p class="eyebrow">
          {isProject ? `De proyecto${p.developer ? ` · ${p.developer.name}` : ''}` : 'De propietario'}
          {p.badge && p.status === 'published' && <span class="deal">{p.badge}</span>}
        </p>
        <h1 class="display">{title}</h1>
        <p class="address">
          <Icon name="pin" size={18} />
          {p.address}, {p.district.name}
        </p>
        {developer && (
          <a class="store-link" href={`/capital/aliados/${developer.slug}`}>
            Ver todos los proyectos de {developer.name}
          </a>
        )}

        <dl class="stats">
          {stats.map((stat) => (
            <div class="stat">
              <span class="stat-icon">
                <Icon name={stat.icon} size={22} />
              </span>
              <dt>{stat.label}</dt>
              <dd>
                <span class:list={['stat-value', { positive: stat.positive }]}>{stat.value}</span>
                <span class="stat-note">{stat.note}</span>
              </dd>
            </div>
          ))}
        </dl>

        {facts.length > 0 && (
          <ul class="facts" aria-label="Características">
            {facts.map((fact, index) => (
              <li>
                <Icon name={(['bed', 'bath', 'area'] as const)[index] ?? 'area'} size={18} />
                {fact}
              </li>
            ))}
          </ul>
        )}

        <p class="note">
          <Icon name="info" size={16} />
          Renta estimada. No constituye una garantía de rentabilidad futura.
        </p>

        {p.description && (
          <section class="about" aria-labelledby="about-title">
            <h2 id="about-title">Sobre este inmueble</h2>
            <p class="description">{p.description}</p>
          </section>
        )}
      </div>

      <!-- ---------- Caja de compra: como el recuadro de "Agregar al carrito" ---------- -->
      <aside class="buybox" aria-labelledby="buybox-price">
        <p class="buy-price" id="buybox-price">
          <span class="sr-only">Valor:</span>
          {price}
        </p>
        <p class="buy-line">
          Rentabilidad estimada <strong class="buy-yield">{formatYield(p.yield)}</strong>
        </p>
        <p class="buy-line">Se recupera en {formatYears(p.paybackYears)}</p>
        <p class:list={['buy-status', `is-${p.status}`]}>{statusLabel}</p>

        <div class="buy-actions">
          {p.status !== 'sold' && <SaveButton id={p.id} name={p.district.name} class="btn--block" />}
          <a class="btn btn--primary btn--sm btn--block" href={`/mis-inmuebles?agregar=${p.id}`}>
            <Icon name="mail" size={18} />
            Contactar
          </a>
        </div>

        <ul class="buy-trust">
          <li>
            <Icon name="handshake" size={18} />
            Te acompañamos hasta la firma
          </li>
          <li>
            <Icon name="calendar" size={18} />
            Coordinamos la visita contigo
          </li>
          <li>
            <Icon name="shield" size={18} />
            Cierras directo con {isProject ? 'la inmobiliaria' : 'el propietario'}
          </li>
        </ul>
      </aside>
    </div>

    <!-- ---------- Aliado del proyecto ---------- -->
    <section class="ally" aria-labelledby="ally-title">
      <h2 id="ally-title" class="section-label">
        {isProject ? 'Aliado del proyecto' : 'Te acompaña'}
      </h2>
      <div class="ally-card">
        <span class="ally-icon">
          <Icon name="building" size={26} />
        </span>
        <div>
          <p class="ally-name">{developer?.name ?? 'DepaHost Capital'}</p>
          <p class="ally-text">
            {developer
              ? (developer.description ?? 'Inmobiliaria aliada de DepaHost Capital.')
              : 'Plataforma inmobiliaria con enfoque en inversión accesible y de confianza.'}
          </p>
        </div>
        {developer && developer.projectCount > 1 && (
          <a class="ally-link" href={`/capital/aliados/${developer.slug}`}>
            Ver sus {developer.projectCount} proyectos <Icon name="arrow-right" size={16} />
          </a>
        )}
      </div>
    </section>

    <!-- ---------- Inmuebles similares ---------- -->
    {similar.length > 0 && (
      <section class="similar" aria-labelledby="similar-title">
        <h2 id="similar-title" class="display">
          Inmuebles similares que te pueden interesar
        </h2>
        <div class="similar-list">
          {similar.map((s) => (
            <MiniCard property={s} />
          ))}
        </div>
      </section>
    )}

    <p class="disclaimer">{disclaimer}</p>
  </article>
</BaseLayout>

<script>
  import { getHistoryStore } from '../../lib/saved-store'

  // Guarda la visita para "Para ti, según lo que has visto"
  const id = document.querySelector<HTMLElement>('[data-property-id]')?.dataset.propertyId
  if (id) getHistoryStore().touch(id)
</script>

<style>
  .detail {
    padding-block: var(--space-4) var(--space-12);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .breadcrumb a {
    color: var(--color-navy-800);
  }
  .detail-top {
    display: grid;
    gap: var(--space-6);
  }
  .detail-info {
    min-width: 0;
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  /* "Súper precio": insignia roja de oferta */
  .deal {
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-deal);
    color: #fff;
    letter-spacing: var(--ls-caps);
  }
  h1 {
    margin-top: var(--space-2);
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.375rem);
    color: var(--color-navy-800);
  }
  .address {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .store-link {
    display: inline-block;
    margin-top: var(--space-1);
    color: var(--color-navy-800);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }
  .stats {
    margin: var(--space-3) 0 0;
    border-top: var(--border-subtle);
  }
  .stat {
    display: grid;
    /* la etiqueta no se corta; si falta espacio, el valor ("8–10% anual") pasa a 2 líneas */
    grid-template-columns: 44px auto minmax(min-content, 1fr);
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .stat + .stat {
    border-top: var(--border-subtle);
  }
  .stat-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: var(--color-navy-800);
    color: #fff;
  }
  dt {
    color: var(--color-text-muted);
  }
  dd {
    display: grid;
    justify-items: end;
    margin: 0;
    text-align: right;
  }
  .stat-value {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    color: var(--color-text-strong);
    font-variant-numeric: tabular-nums;
  }
  .stat-value.positive {
    color: var(--color-success);
  }
  .stat-note {
    font-size: var(--fs-13);
    color: var(--color-text-muted);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-2) 0 0;
    padding: var(--space-3) 0 0;
    border-top: var(--border-subtle);
    list-style: none;
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .facts :global(svg) {
    color: var(--color-navy-800);
  }
  .note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    font-size: var(--fs-13);
    color: var(--color-text-muted);
  }
  .about {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border-subtle);
  }
  .about h2 {
    font-size: var(--fs-18);
    letter-spacing: 0;
  }
  .description {
    max-width: 70ch;
    margin: var(--space-2) 0 0;
    white-space: pre-line;
  }

  /* ---------- Caja de compra ---------- */
  .buybox {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .buybox p {
    margin: 0;
  }
  .buy-price {
    color: var(--color-text-strong);
    font-size: 1.875rem;
    font-weight: var(--fw-bold);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .buy-line {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .buy-yield {
    color: var(--color-success);
  }
  .buy-status {
    font-size: var(--fs-18);
    font-weight: var(--fw-semibold);
  }
  .buy-status.is-published {
    color: var(--color-success);
  }
  .buy-status.is-reserved {
    color: #b25e09;
  }
  .buy-status.is-sold {
    color: var(--color-error);
  }
  .buy-actions {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .buy-actions > :global(*) {
    min-height: var(--control-h-md);
    border-radius: var(--radius-pill);
  }
  .buy-trust {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: var(--space-3) 0 0;
    border-top: var(--border-subtle);
    list-style: none;
    font-size: var(--fs-13);
    color: var(--color-text);
  }
  .buy-trust li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .buy-trust :global(svg) {
    flex: none;
    color: var(--color-navy-800);
  }

  /* ---------- Aliado ---------- */
  .ally {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: var(--border-subtle);
  }
  .section-label {
    justify-self: start;
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-navy-800);
    font-size: var(--fs-18);
    letter-spacing: 0;
    color: var(--color-navy-800);
  }
  .ally-card {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
  }
  .ally-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: var(--border);
    border-radius: var(--radius-pill);
    color: var(--color-navy-800);
  }
  .ally-name {
    margin: 0;
    font-weight: var(--fw-semibold);
    color: var(--color-text-strong);
  }
  .ally-text {
    margin: 2px 0 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .ally-link {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-navy-800);
    font-weight: var(--fw-semibold);
  }

  /* ---------- Similares ---------- */
  .similar {
    margin-top: var(--space-10);
  }
  .similar h2 {
    margin-bottom: var(--space-4);
    font-size: var(--fs-h3);
    letter-spacing: 0;
    color: var(--color-navy-800);
  }
  .similar-list {
    display: grid;
    gap: var(--space-3);
  }
  .disclaimer {
    margin-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .similar-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .detail-top {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-8);
    }
    .buybox {
      grid-column: 2;
    }
    .ally-card {
      grid-template-columns: 56px minmax(0, 1fr) auto;
    }
    .ally-link {
      grid-column: auto;
    }
    .similar-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* Pantallas anchas: galería, datos y caja de compra en tres columnas; la caja acompaña al bajar */
  @media (min-width: 1280px) {
    .detail-top {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) 280px;
      gap: var(--space-6);
    }
    .buybox {
      grid-column: auto;
      position: sticky;
      top: calc(var(--header-h) + var(--space-4));
    }
  }
</style>
