---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Button from '../../components/Button.astro'
import Icon from '../../components/Icon.astro'
import PropertyCard from '../../components/PropertyCard.astro'
import PropertyGrid from '../../components/PropertyGrid.astro'
import SearchFilters from '../../components/SearchFilters.astro'
import Step from '../../components/Step.astro'
import { getFastFilters, getOwnerProperties, getProperties } from '../../lib/properties'

const steps = [
  { number: 1, title: 'Comparas' },
  { number: 2, title: 'Consultas' },
  { number: 3, title: 'Te acompañamos' },
  { number: 4, title: 'Cierras' },
]

// La portada muestra los inmuebles de propietarios; los proyectos de inmobiliarias están en sus páginas
const depas = await getOwnerProperties()
const total = (await getProperties()).length
const fastFilters = await getFastFilters(depas)
---

<BaseLayout
  title="Capital"
  description="DepaHost Capital: los mejores inmuebles para invertir en Lima, de propietarios y de inmobiliarias aliadas."
>
  <!-- ---------- Hero: "DepaHost Capital" es sub-marca, por eso solo va aquí ---------- -->
  <section class="container hero" data-hero>
    <div class="hero-text">
      <!-- Siempre en 2 líneas (ver .hero h1) -->
      <h1 class="display">
        <span>Los mejores inmuebles</span>
        <span>para invertir en Lima.</span>
      </h1>
      <p class="hero-sub">Seleccionados según el perfil, necesidades y objetivos de cada cliente.</p>
      <div class="btn-group ctas">
        <Button href="/capital/inmuebles">Ver todos los proyectos</Button>
      </div>
    </div>

    <!-- Cómo funciona: pasos a la derecha del título -->
    <div id="como-funciona" class="hero-steps">
      <h2 class="sr-only">Cómo funciona</h2>
      <ol class="stepper">
        {steps.map((s) => (
          <Step {...s} />
        ))}
      </ol>
    </div>
  </section>

  <!-- ---------- Inmuebles de propietarios: buscador, filtros y tarjetas ---------- -->
  <!-- Máximo 6 inmuebles a la vista; el buscador y los filtros buscan entre todos (property-filters.ts) -->
  <section
    id="proyectos"
    class="container listing"
    data-filter-root
    data-max-visible="6"
    data-filter-pending
    aria-labelledby="depas-title"
  >
    <h2 id="depas-title" class="sr-only">
      Inmuebles de propietarios
    </h2>
    <SearchFilters filters={fastFilters} />

    <PropertyGrid id="lista-inmuebles" label="Inmuebles de propietarios">
      {depas.map((d, index) => (
        <PropertyCard property={d} priority={index < 3} />
      ))}
      <!-- Al final de la lista: lleva a la búsqueda con todos los filtros -->
      <a class="see-all-tile" href="/capital/inmuebles">
        <span class="see-all-icon">
          <Icon name="search" size={26} />
        </span>
        <span class="see-all-text">
          <strong>Ver todos los proyectos</strong>
          <span>{total} inmuebles de propietarios e inmobiliarias</span>
        </span>
        <Icon name="arrow-right" size={24} class="see-all-arrow" />
      </a>
    </PropertyGrid>
    <p class="no-results" data-filter-empty role="status" hidden>
      No encontramos inmuebles con esos criterios.
    </p>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-block: var(--space-8) var(--space-8);
  }
  .hero-text {
    /* el tamaño del título se calcula sobre el ancho de esta columna */
    container-type: inline-size;
  }
  .hero h1 {
    /* 2 líneas en cualquier pantalla: la más larga ("Los mejores inmuebles") mide ~11.35em en Poppins,
       así que el tamaño sale del ancho disponible (8.6cqi deja un margen), con tope de 60px.
       Si cambia el texto o la fuente, hay que volver a medir la línea más larga */
    font-size: min(3.75rem, 8.6cqi);
    line-height: 1.05;
    color: var(--color-navy-800);
  }
  .hero h1 span {
    display: block;
    white-space: nowrap;
  }
  .hero-sub {
    margin: var(--space-3) 0 0;
    max-width: 34rem;
    font-size: var(--fs-lead);
    color: var(--color-text-muted);
  }
  .ctas {
    margin-top: var(--space-6);
  }
  /* Antes de que corra el script de filtros: solo las primeras 6 tarjetas (sin salto al cargar) */
  .listing[data-filter-pending] :global(article[data-property-card]:nth-of-type(n + 7)) {
    display: none;
  }
  .listing {
    padding-bottom: var(--space-4);
  }
  .no-results {
    margin: var(--space-5) 0;
    color: var(--color-text-muted);
  }
  .no-results[hidden] {
    display: none;
  }
  /* Tarjeta "Ver todos los proyectos" al final de la lista: en móvil es la última del carrusel,
     desde 640px ocupa toda la fila */
  .see-all-tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 2px dashed var(--color-gold-700);
    border-radius: var(--radius-lg);
    background: var(--color-gold-100);
    color: var(--color-navy-800);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .see-all-tile:hover {
    background: #f6e6c4;
  }
  .see-all-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: var(--color-gold-500);
    color: var(--color-navy-900);
  }
  .see-all-text {
    display: grid;
    gap: var(--space-1);
  }
  .see-all-text strong {
    font-size: var(--fs-20);
  }
  .see-all-text span {
    color: var(--color-text);
    font-size: var(--fs-15);
  }
  @media (min-width: 640px) {
    .see-all-tile {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      padding: var(--space-4) var(--space-6);
    }
    .see-all-tile :global(.see-all-arrow) {
      margin-left: auto;
      flex: none;
    }
  }
  /* Pasos a la derecha del título solo desde 1280px: antes no entran los 4 en la columna
     y se montan sobre el título; quedan debajo, como en tablet */
  @media (min-width: 1280px) {
    .hero {
      display: grid;
      /* el título (izquierda) necesita más ancho para quedar en 2 líneas */
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 0;
      align-items: center;
      padding-block: var(--space-6) var(--space-4);
    }
    .hero-steps .stepper {
      margin-top: 0;
    }
  }

  /* ---------- Pasos ---------- */
  /* Móvil: no se muestran (el hero queda corto y la lista sube). Desde 640px: 4 columnas */
  .hero-steps {
    display: none;
  }
  .stepper {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .hero-steps {
      display: block;
    }
  }
  @media (min-width: 640px) {
    .stepper {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
