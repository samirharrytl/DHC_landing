---
// Proyectos de una inmobiliaria aliada. Una página por inmobiliaria con proyectos publicados.
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Icon from '../../../components/Icon.astro'
import ProjectCard from '../../../components/ProjectCard.astro'
import SearchFilters from '../../../components/SearchFilters.astro'
import {
  getDeveloperProjects,
  getDevelopers,
  getFastFilters,
  getFinancingAssumptions,
} from '../../../lib/properties'
import { buildDisclaimer } from '../../../lib/format'
import type { Developer } from '../../../types/property'

export const getStaticPaths = (async () => {
  const developers = (await getDevelopers()).filter((d) => d.projectCount > 0)
  return developers.map((developer) => ({ params: { slug: developer.slug }, props: { developer } }))
}) satisfies GetStaticPaths

interface Props {
  developer: Developer
}

const { developer } = Astro.props
const projects = await getDeveloperProjects(developer.id)
const filters = await getFastFilters(projects)
const disclaimer = buildDisclaimer(await getFinancingAssumptions())
---

<BaseLayout
  title={`Proyectos de ${developer.name}`}
  description={`Inmuebles en venta de ${developer.name} en Lima, con precio desde y rentabilidad estimada.`}
>
  <section class="container developer" data-filter-root aria-labelledby="developer-title">
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/capital">Capital</a>
      <span aria-hidden="true">›</span>
      <a href="/capital#aliados">Aliados</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{developer.name}</span>
    </nav>

    <header class="developer-head">
      <p class="eyebrow">
        <Icon name="building" size={16} /> Inmobiliaria aliada
      </p>
      <h1 id="developer-title" class="display">
        Proyectos de <strong>{developer.name}</strong>
      </h1>
      <p class="lead">{developer.description ?? 'Inmuebles en venta de esta inmobiliaria.'}</p>
      {developer.website && (
        <a class="website" href={developer.website} target="_blank" rel="noopener noreferrer">
          Sitio web de {developer.name} <Icon name="arrow-right" size={16} />
        </a>
      )}
    </header>

    <SearchFilters
      filters={filters}
      placeholder="Buscar por distrito, proyecto o palabra clave"
      withButton
      count={{ singular: 'proyecto encontrado', plural: 'proyectos encontrados' }}
    />

    <div class="projects" role="region" aria-label={`Proyectos de ${developer.name}`}>
      {projects.map((p, index) => (
        <ProjectCard property={p} priority={index < 3} />
      ))}
    </div>
    <p class="no-results" data-filter-empty role="status" hidden>
      No encontramos proyectos con esos criterios.
    </p>

    <p class="disclaimer">{disclaimer}</p>
    <a class="back" href="/capital#lista-inmuebles">
      <Icon name="arrow-left" size={18} /> Volver a todos los inmuebles
    </a>
  </section>
</BaseLayout>

<style>
  .developer {
    padding-block: var(--space-6) var(--space-12);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .breadcrumb a {
    color: var(--color-navy-800);
  }
  .developer-head {
    margin-bottom: var(--space-6);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  h1 {
    margin-top: var(--space-2);
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-navy-800);
  }
  h1 strong {
    font-weight: 600;
  }
  .lead {
    margin-top: var(--space-2);
  }
  .website {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-3);
    color: var(--color-navy-800);
    font-weight: var(--fw-semibold);
  }
  .projects {
    display: grid;
    gap: var(--grid-gap);
  }
  .no-results {
    margin: var(--space-5) 0;
    color: var(--color-text-muted);
  }
  .no-results[hidden] {
    display: none;
  }
  .disclaimer {
    margin-top: var(--space-6);
  }
  .back {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: fit-content;
    min-height: var(--control-h-sm);
    margin: var(--space-8) auto 0;
    color: var(--color-navy-800);
    font-weight: var(--fw-medium);
    text-underline-offset: 6px;
  }
  @media (min-width: 640px) {
    .projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .projects {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
