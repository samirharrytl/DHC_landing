---
// "Todos los inmuebles": la búsqueda completa de Capital, como los resultados de una tienda en línea.
// Todos los inmuebles (de propietarios y de proyectos) salen del build; los filtros de la barra lateral,
// el buscador y el orden se aplican en el navegador (lógica en src/lib/catalog-search.ts) y quedan
// en la URL (?distrito=lince&orden=precio-asc), así la búsqueda se puede compartir.
// "Cerca de" ordena por distancia a la ubicación de la persona o a un lugar de la lista (src/lib/geo.ts).
// "Mapa" muestra los mismos resultados como pines (src/scripts/depas-map.ts, se carga al elegirlo).
import BaseLayout from '../../layouts/BaseLayout.astro'
import Icon from '../../components/Icon.astro'
import PropertyCard from '../../components/PropertyCard.astro'
import { getDevelopers, getFinancingAssumptions, getProperties } from '../../lib/properties'
import { buildDisclaimer, formatPEN } from '../../lib/format'
import { DISTANCE_STEPS, paybackSteps, priceRanges, SORT_OPTIONS, yieldSteps } from '../../lib/catalog-search'
import { DISTRITOS, LUGARES } from '../../data/lugares'

const depas = await getProperties()
const developers = (await getDevelopers()).filter((d) => d.projectCount > 0)
const disclaimer = buildDisclaimer(await getFinancingAssumptions())

const districts = [...new Map(depas.map((d) => [d.district.slug, d.district.name]))].sort((a, b) =>
  a[1].localeCompare(b[1], 'es'),
)
const prices = priceRanges(
  depas.map((d) => d.price.amount),
  formatPEN,
)
const yields = yieldSteps(depas.map((d) => d.yield.min))
const paybacks = paybackSteps(depas.map((d) => d.paybackYears))
const hasReserved = depas.some((d) => d.status === 'reserved')

const origins = [
  { value: 'owner', label: 'De propietario' },
  { value: 'developer', label: 'De proyecto' },
]
---

<BaseLayout
  title="Todos los inmuebles"
  description="Todos los inmuebles para invertir en Lima de DepaHost Capital: filtra por distrito, precio, rentabilidad, plazo y cercanía."
>
  <div class="container results-page" data-depa-search>
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/capital">Capital</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Todos los inmuebles</span>
    </nav>

    <header class="results-head">
      <h1 class="display">Todos los inmuebles</h1>
      <form class="search" role="search" data-search-form>
        <Icon name="search" size={22} class="search-icon" />
        <input
          type="search"
          name="q"
          placeholder="Busca por distrito, dirección, inmobiliaria o precio"
          aria-label="Buscar inmuebles"
          autocomplete="off"
          data-search-input
        />
        <button type="submit" class="btn btn--cta search-button">
          Buscar
        </button>
      </form>
    </header>

    <div class="results-bar">
      <p class="results-count" data-results-count role="status" aria-live="polite">
        {depas.length} resultados
      </p>
      <div class="results-tools">
        <div class="view-toggle" role="group" aria-label="Ver resultados como">
          <button type="button" aria-pressed="true" data-view="lista">
            <Icon name="list" size={18} />
            Lista
          </button>
          <button type="button" aria-pressed="false" data-view="mapa">
            <Icon name="map" size={18} />
            Mapa
          </button>
        </div>
        <button
          type="button"
          class="btn btn--secondary btn--sm filters-open"
          aria-expanded="false"
          aria-controls="filtros"
          data-filters-open
        >
          <Icon name="sliders" size={18} />
          Filtros <span class="filters-badge" data-filters-badge hidden></span>
        </button>
        <label class="sort">
          <span>Ordenar por</span>
          <select data-sort>
            {SORT_OPTIONS.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>
    </div>

    <!-- Avisos de "Cerca de": buscando la ubicación, permiso denegado… -->
    <div class="near-status" role="status" data-near-status></div>

    <div class="chips" data-active-chips hidden>
      <ul data-chip-list aria-label="Filtros activos"></ul>
      <button type="button" class="clear-all" data-clear-all>
        Limpiar todo
      </button>
    </div>

    <div class="layout">
      <!-- Barra lateral de filtros. En móvil es un panel que se abre con "Filtros". -->
      <aside id="filtros" class="filters" aria-labelledby="filters-title" data-filters>
        <div class="filters-head">
          <h2 id="filters-title" tabindex="-1" data-filters-title>
            Filtros
          </h2>
          <button type="button" class="filters-close" aria-label="Cerrar filtros" data-filters-close>
            <Icon name="x" size={22} />
          </button>
        </div>

        <div class="filters-body">
          <fieldset class="group near">
            <legend>Cerca de</legend>
            <button type="button" class="btn btn--secondary btn--sm near-locate" data-near-locate>
              <Icon name="locate" size={18} />
              <span data-near-locate-label>Usar mi ubicación</span>
            </button>
            <label class="near-field">
              <span>O elige un lugar</span>
              <select data-near-select>
                <option value="">Elige un distrito o lugar</option>
                {LUGARES.map((group) => (
                  <optgroup label={group.group}>
                    {group.places.map((place) => (
                      <option value={place.slug}>{place.name}</option>
                    ))}
                  </optgroup>
                ))}
                <optgroup label="Distritos">
                  {DISTRITOS.map((district) => (
                    <option value={district.slug}>{district.name}</option>
                  ))}
                </optgroup>
              </select>
            </label>
            <div class="near-radius" data-near-radius hidden>
              {DISTANCE_STEPS.map((km) => (
                <label class="facet">
                  <input type="radio" name="km" value={km} data-facet="distance" />
                  <span data-label>Hasta {km} km</span>
                  <span class="facet-count" data-facet-count />
                </label>
              ))}
              <button type="button" class="clear-group" data-clear-group="distance" hidden>
                Borrar distancia
              </button>
            </div>
          </fieldset>

          <fieldset class="group">
            <legend>Tipo</legend>
            {origins.map((o) => (
              <label class="facet">
                <input type="checkbox" name="tipo" value={o.value} data-facet="origin" />
                <span data-label>{o.label}</span>
                <span class="facet-count" data-facet-count />
              </label>
            ))}
          </fieldset>

          <fieldset class="group">
            <legend>Distrito</legend>
            {districts.map(([slug, name]) => (
              <label class="facet">
                <input type="checkbox" name="distrito" value={slug} data-facet="district" />
                <span data-label>{name}</span>
                <span class="facet-count" data-facet-count />
              </label>
            ))}
          </fieldset>

          {developers.length > 0 && (
            <fieldset class="group">
              <legend>Inmobiliaria</legend>
              {developers.map((d) => (
                <label class="facet">
                  <input type="checkbox" name="inmobiliaria" value={d.slug} data-facet="developer" />
                  <span data-label>{d.name}</span>
                  <span class="facet-count" data-facet-count />
                </label>
              ))}
            </fieldset>
          )}

          <fieldset class="group">
            <legend>Precio</legend>
            {prices.map((range) => (
              <label class="facet">
                <input
                  type="radio"
                  name="precio"
                  value={`${range.min ?? ''}-${range.max ?? ''}`}
                  data-facet="price"
                  data-min={range.min}
                  data-max={range.max}
                />
                <span data-label>{range.label}</span>
                <span class="facet-count" data-facet-count />
              </label>
            ))}
            <div class="price-custom" data-price-custom>
              <label>
                <span class="sr-only">Precio mínimo en soles</span>
                <input type="text" inputmode="numeric" placeholder="S/ Mín" data-price-min />
              </label>
              <label>
                <span class="sr-only">Precio máximo en soles</span>
                <input type="text" inputmode="numeric" placeholder="S/ Máx" data-price-max />
              </label>
              <button type="button" class="btn btn--secondary btn--sm" data-price-apply>
                Ir
              </button>
            </div>
            <button type="button" class="clear-group" data-clear-group="price" hidden>
              Borrar precio
            </button>
          </fieldset>

          {yields.length > 0 && (
            <fieldset class="group">
              <legend>Rentabilidad estimada</legend>
              {yields.map((y) => (
                <label class="facet">
                  <input type="radio" name="rentabilidad" value={y} data-facet="yield" />
                  <span data-label>Desde {y}% anual</span>
                  <span class="facet-count" data-facet-count />
                </label>
              ))}
              <button type="button" class="clear-group" data-clear-group="yield" hidden>
                Borrar rentabilidad
              </button>
            </fieldset>
          )}

          {paybacks.length > 0 && (
            <fieldset class="group">
              <legend>Se paga en</legend>
              {paybacks.map((y) => (
                <label class="facet">
                  <input type="radio" name="plazo" value={y} data-facet="payback" />
                  <span data-label>Hasta {y} años</span>
                  <span class="facet-count" data-facet-count />
                </label>
              ))}
              <button type="button" class="clear-group" data-clear-group="payback" hidden>
                Borrar plazo
              </button>
            </fieldset>
          )}

          {hasReserved && (
            <fieldset class="group">
              <legend>Disponibilidad</legend>
              <label class="facet">
                <input type="checkbox" name="disponibles" value="1" data-facet="available" />
                <span data-label>Solo disponibles</span>
                <span class="facet-count" data-facet-count />
              </label>
            </fieldset>
          )}
        </div>

        <div class="filters-foot">
          <button type="button" class="btn btn--cta btn--block" data-filters-close>
            <span data-results-short>Ver {depas.length} resultados</span>
          </button>
        </div>
      </aside>
      <div class="filters-backdrop" data-filters-backdrop hidden></div>

      <section class="results" aria-labelledby="results-title">
        <h2 id="results-title" class="sr-only">
          Resultados
        </h2>
        <div class="results-map" data-results-map hidden>
          <div class="map-canvas" data-map-canvas></div>
          <p class="map-message" data-map-message>
            Cargando mapa…
          </p>
        </div>
        <div class="results-grid" data-results>
          {depas.map((d, index) => (
            <PropertyCard property={d} priority={index < 3} />
          ))}
        </div>
        <div class="empty" data-results-empty hidden>
          <Icon name="search" size={28} />
          <p>No encontramos inmuebles con esos filtros.</p>
          <button type="button" class="btn btn--secondary btn--sm" data-clear-all>
            Limpiar filtros
          </button>
        </div>
        <p class="disclaimer">{disclaimer}</p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    matchesQuery,
    queryFromParams,
    queryToParams,
    sortDepas,
    type DepaQuery,
    type FacetGroup,
    type SearchableDepa,
    type SortKey,
  } from '../../lib/catalog-search'
  import { formatPEN } from '../../lib/format'
  import type { DepasMap, MapDepa } from '../../scripts/depas-map'
  import {
    districtCenter,
    distanceKm,
    formatDistance,
    isNearLima,
    MY_LOCATION,
    placeBySlug,
    type Point,
  } from '../../lib/geo'

  const root = document.querySelector<HTMLElement>('[data-depa-search]')
  if (root) {
    const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector)!
    const grid = $<HTMLElement>('[data-results]')
    const searchForm = $<HTMLFormElement>('[data-search-form]')
    const searchInput = $<HTMLInputElement>('[data-search-input]')
    const sortSelect = $<HTMLSelectElement>('[data-sort]')
    const count = $<HTMLElement>('[data-results-count]')
    const countShort = $<HTMLElement>('[data-results-short]')
    const empty = $<HTMLElement>('[data-results-empty]')
    const chips = $<HTMLElement>('[data-active-chips]')
    const chipList = $<HTMLUListElement>('[data-chip-list]')
    const badge = $<HTMLElement>('[data-filters-badge]')
    const priceMin = $<HTMLInputElement>('[data-price-min]')
    const priceMax = $<HTMLInputElement>('[data-price-max]')
    const facets = [...root.querySelectorAll<HTMLInputElement>('[data-facet]')]
    const nearSelect = $<HTMLSelectElement>('[data-near-select]')
    const nearRadius = $<HTMLElement>('[data-near-radius]')
    const nearStatus = $<HTMLElement>('[data-near-status]')
    const locateButton = $<HTMLButtonElement>('[data-near-locate]')
    const locateLabel = $<HTMLElement>('[data-near-locate-label]')
    const mapBox = $<HTMLElement>('[data-results-map]')
    const mapCanvas = $<HTMLElement>('[data-map-canvas]')
    const mapMessage = $<HTMLElement>('[data-map-message]')
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')]

    type Item = SearchableDepa & {
      card: HTMLElement
      position?: Point & { exact: boolean }
      distance: HTMLElement
      distanceText: HTMLElement
      /** Para la mini tarjeta del mapa */
      district: string
      address: string
      href: string
    }
    const items: Item[] = [...grid.querySelectorAll<HTMLElement>('[data-property-card]')].map(
      (card, order) => ({
        card,
        order,
        id: card.dataset.id ?? '',
        districtSlug: card.dataset.district ?? '',
        origin: card.dataset.origin === 'developer' ? 'developer' : 'owner',
        developerSlug: card.dataset.developer ?? null,
        price: Number(card.dataset.price),
        yieldMin: Number(card.dataset.yieldMin),
        yieldMax: Number(card.dataset.yieldMax),
        paybackYears: Number(card.dataset.payback),
        status: (card.dataset.status ?? 'published') as SearchableDepa['status'],
        searchText: card.dataset.search ?? '',
        position:
          card.dataset.lat && card.dataset.lng
            ? { lat: Number(card.dataset.lat), lng: Number(card.dataset.lng), exact: 'exact' in card.dataset }
            : undefined,
        distance: card.querySelector<HTMLElement>('[data-distance]')!,
        distanceText: card.querySelector<HTMLElement>('[data-distance-text]')!,
        district: card.querySelector('.title a')?.textContent?.trim() ?? '',
        address: card.querySelector('.address')?.textContent?.trim() ?? '',
        href: card.querySelector<HTMLAnchorElement>('.title a')?.href ?? '',
      }),
    )

    // ---------- "Cerca de" ----------
    /** Ubicación del navegador: solo en memoria, no va a la URL ni se guarda */
    let myPosition: Point | undefined

    /** El punto de "Cerca de", con su nombre para el chip ("Cerca de Larcomar (Miraflores)") y la tarjeta ("de Larcomar") */
    const originOf = (near: string | undefined) => {
      if (!near) return undefined
      if (near === MY_LOCATION) return myPosition && { ...myPosition, name: 'tu ubicación', from: 'de ti' }
      const place = placeBySlug(near)
      if (!place) return undefined
      return districtCenter(near)
        ? { ...place, from: `del centro de ${place.name}` }
        : { ...place, from: `de ${place.name.replace(/\s*\(.*\)$/, '')}` }
    }

    /** Sin un punto válido en "Cerca de" se quitan la distancia y el orden por cercanía */
    const normalizeNear = () => {
      if (!originOf(query.near)) query.near = undefined
      if (!query.near) {
        query.maxKm = undefined
        if (query.sort === 'cercania') query.sort = 'destacados'
      }
    }

    let query: DepaQuery = queryFromParams(new URLSearchParams(location.search))
    normalizeNear()

    // ---------- Vista: lista o mapa ----------
    let view: 'lista' | 'mapa' =
      new URLSearchParams(location.search).get('vista') === 'mapa' ? 'mapa' : 'lista'
    let visibleItems: Item[] = []
    let depasMap: DepasMap | undefined
    let mapLoading: Promise<void> | undefined

    /** Foto chica de la tarjeta para la mini tarjeta del mapa (la primera del srcset) */
    const thumbnail = (card: HTMLElement) => {
      const source = card.querySelector<HTMLSourceElement>('picture source')
      return source?.srcset.split(',')[0]?.trim().split(' ')[0] || card.querySelector('img')?.src
    }

    const syncMap = () => {
      if (view !== 'mapa' || !depasMap) return
      const origin = originOf(query.near)
      const depas: MapDepa[] = visibleItems.flatMap((item) =>
        item.position
          ? [
              {
                id: item.id,
                lat: item.position.lat,
                lng: item.position.lng,
                exact: item.position.exact,
                price: item.price,
                district: item.district,
                address: item.address,
                href: item.href,
                image: thumbnail(item.card),
                distance:
                  item.distanceKm === undefined ? undefined : (item.distanceText.textContent ?? undefined),
              },
            ]
          : [],
      )
      depasMap.update(
        depas,
        origin && { lat: origin.lat, lng: origin.lng, name: origin.name, radiusKm: query.maxKm },
      )
    }

    /** Leaflet se descarga la primera vez que se abre el mapa */
    const showMap = async () => {
      mapLoading ??= import('../../scripts/depas-map')
        .then(async ({ createDepasMap }) => {
          depasMap = await createDepasMap(mapCanvas)
          mapMessage.hidden = true
        })
        .catch(() => {
          mapMessage.textContent = 'No pudimos cargar el mapa. Revisa tu conexión y vuelve a intentarlo.'
          mapLoading = undefined
        })
      await mapLoading
      depasMap?.resize()
      syncMap()
    }

    const setView = (next: typeof view) => {
      view = next
      for (const button of viewButtons)
        button.setAttribute('aria-pressed', String(button.dataset.view === view))
      grid.hidden = view === 'mapa'
      mapBox.hidden = view !== 'mapa'
    }
    for (const button of viewButtons) {
      button.addEventListener('click', () => {
        setView(button.dataset.view === 'mapa' ? 'mapa' : 'lista')
        render()
        if (view === 'mapa') void showMap()
      })
    }

    const listKey = { origin: 'origins', district: 'districts', developer: 'developers' } as const
    const n = (value: string | undefined) => (value === undefined || value === '' ? undefined : Number(value))

    /** ¿Esta opción coincide con el inmueble? (para contar cuántos inmuebles trae cada opción) */
    const optionMatches = (input: HTMLInputElement, d: SearchableDepa) => {
      const v = input.value
      switch (input.dataset.facet as FacetGroup) {
        case 'origin':
          return d.origin === v
        case 'district':
          return d.districtSlug === v
        case 'developer':
          return d.developerSlug === v
        case 'price': {
          const min = n(input.dataset.min)
          const max = n(input.dataset.max)
          return (min === undefined || d.price >= min) && (max === undefined || d.price <= max)
        }
        case 'yield':
          return d.yieldMin >= Number(v)
        case 'payback':
          return d.paybackYears <= Number(v)
        case 'available':
          return d.status === 'published'
        case 'distance':
          return d.distanceKm != null && d.distanceKm <= Number(v)
      }
    }

    /** ¿La opción está activa en la búsqueda actual? */
    const isActive = (input: HTMLInputElement) => {
      const group = input.dataset.facet as FacetGroup
      if (group === 'origin' || group === 'district' || group === 'developer')
        return (query[listKey[group]] as string[]).includes(input.value)
      if (group === 'price')
        return query.minPrice === n(input.dataset.min) && query.maxPrice === n(input.dataset.max)
      if (group === 'yield') return query.minYield === Number(input.value)
      if (group === 'payback') return query.maxPayback === Number(input.value)
      if (group === 'distance') return query.maxKm === Number(input.value)
      return query.available
    }

    const labelOf = (input: HTMLInputElement) =>
      input.closest('label')?.querySelector('[data-label]')?.textContent?.trim() ?? input.value

    /** Quita un filtro: lo usan los chips y los botones "Borrar". */
    const removers: Record<FacetGroup, (value?: string) => void> = {
      origin: (v) => (query.origins = query.origins.filter((x) => x !== v)),
      district: (v) => (query.districts = query.districts.filter((x) => x !== v)),
      developer: (v) => (query.developers = query.developers.filter((x) => x !== v)),
      price: () => {
        query.minPrice = undefined
        query.maxPrice = undefined
      },
      yield: () => (query.minYield = undefined),
      payback: () => (query.maxPayback = undefined),
      available: () => (query.available = false),
      distance: () => (query.maxKm = undefined),
    }

    const chip = (label: string, onRemove: () => void) => {
      const li = document.createElement('li')
      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'chip'
      button.textContent = label
      button.setAttribute('aria-label', `Quitar filtro: ${label}`)
      button.insertAdjacentHTML(
        'beforeend',
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>',
      )
      button.addEventListener('click', () => {
        onRemove()
        apply()
      })
      li.append(button)
      return li
    }

    const render = () => {
      // Distancia de cada inmueble al punto de "Cerca de"
      const origin = originOf(query.near)
      for (const item of items) {
        item.distanceKm = origin && item.position ? distanceKm(origin, item.position) : undefined
        item.distance.hidden = item.distanceKm === undefined
        if (origin && item.position && item.distanceKm !== undefined)
          item.distanceText.textContent = `${formatDistance(item.distanceKm, item.position.exact)} ${origin.from}`
      }

      // Resultados: los que coinciden, en el orden elegido; el resto queda oculto al final
      const visible = sortDepas(
        items.filter((d) => matchesQuery(d, query)),
        query.sort,
      )
      visibleItems = visible
      const shown = new Set(visible)
      for (const item of items) item.card.hidden = !shown.has(item)
      grid.append(
        ...visible.map((item) => item.card),
        ...items.filter((i) => !shown.has(i)).map((i) => i.card),
      )

      const total = visible.length
      count.textContent = `${total} ${total === 1 ? 'resultado' : 'resultados'}${query.q.trim() ? ` para "${query.q.trim()}"` : ''}`
      countShort.textContent = `Ver ${total} ${total === 1 ? 'resultado' : 'resultados'}`
      empty.hidden = total > 0

      // Controles: marcados según la búsqueda, con cuántos inmuebles trae cada opción
      for (const input of facets) {
        const group = input.dataset.facet as FacetGroup
        const amount = items.filter((d) => matchesQuery(d, query, group) && optionMatches(input, d)).length
        input.checked = isActive(input)
        input.disabled = amount === 0 && !input.checked
        const label = input.closest('label')!
        label.classList.toggle('is-empty', input.disabled)
        label.querySelector('[data-facet-count]')!.textContent = `(${amount})`
      }
      const customPrice =
        (query.minPrice !== undefined || query.maxPrice !== undefined) &&
        !facets.some((input) => input.dataset.facet === 'price' && input.checked)
      priceMin.value = customPrice && query.minPrice !== undefined ? String(query.minPrice) : ''
      priceMax.value = customPrice && query.maxPrice !== undefined ? String(query.maxPrice) : ''
      const groupIsSet: Partial<Record<FacetGroup, boolean>> = {
        price: query.minPrice !== undefined || query.maxPrice !== undefined,
        yield: query.minYield !== undefined,
        payback: query.maxPayback !== undefined,
        distance: query.maxKm !== undefined,
      }
      root.querySelectorAll<HTMLElement>('[data-clear-group]').forEach((button) => {
        button.hidden = !groupIsSet[button.dataset.clearGroup as FacetGroup]
      })
      nearSelect.value = query.near ?? ''
      nearRadius.hidden = !origin
      if (document.activeElement !== searchInput) searchInput.value = query.q
      sortSelect.value = query.sort

      // Chips de filtros activos
      const active: HTMLLIElement[] = []
      if (query.q.trim()) active.push(chip(`"${query.q.trim()}"`, () => (query.q = '')))
      if (origin) active.push(chip(`Cerca de ${origin.name}`, clearNear))
      for (const input of facets) {
        if (!input.checked) continue
        const group = input.dataset.facet as FacetGroup
        active.push(chip(labelOf(input), () => removers[group](input.value)))
      }
      if (customPrice) {
        const from = query.minPrice !== undefined ? formatPEN(query.minPrice) : ''
        const to = query.maxPrice !== undefined ? formatPEN(query.maxPrice) : ''
        const label = from && to ? `${from} a ${to}` : from ? `Desde ${from}` : `Hasta ${to}`
        active.push(chip(label, removers.price))
      }
      chipList.replaceChildren(...active)
      chips.hidden = active.length === 0
      const filterCount = active.length - (query.q.trim() ? 1 : 0)
      badge.hidden = filterCount === 0
      badge.textContent = String(filterCount)

      syncMap()

      // La URL guarda la búsqueda y la vista (para compartirla o volver con "Atrás")
      const params = queryToParams(query)
      if (view === 'mapa') params.set('vista', 'mapa')
      const search = params.toString()
      history.replaceState(null, '', search ? `${location.pathname}?${search}` : location.pathname)
    }
    const apply = render

    // ---------- Eventos ----------
    /** Pasa el estado de una opción (marcada o no) a la búsqueda. */
    const readInput = (input: HTMLInputElement) => {
      const group = input.dataset.facet as FacetGroup
      if (group === 'origin' || group === 'district' || group === 'developer') {
        const key = listKey[group]
        const values = query[key].filter((v) => v !== input.value)
        query[key] = input.checked ? [...values, input.value] : values
      } else if (group === 'price') {
        query.minPrice = n(input.dataset.min)
        query.maxPrice = n(input.dataset.max)
      } else if (group === 'yield') query.minYield = Number(input.value)
      else if (group === 'payback') query.maxPayback = Number(input.value)
      else if (group === 'distance') query.maxKm = Number(input.value)
      else query.available = input.checked
    }
    for (const input of facets) {
      input.addEventListener('change', () => {
        readInput(input)
        apply()
      })
    }
    // Lo que se marcó antes de que cargara este script (conexión lenta) también cuenta
    for (const input of facets) if (input.checked && !isActive(input)) readInput(input)

    const amount = (value: string) => {
      const digits = value.replace(/[^\d]/g, '')
      return digits ? Number(digits) : undefined
    }
    const applyCustomPrice = () => {
      let [min, max] = [amount(priceMin.value), amount(priceMax.value)]
      if (min !== undefined && max !== undefined && min > max) [min, max] = [max, min]
      query.minPrice = min
      query.maxPrice = max
      apply()
    }
    $('[data-price-apply]').addEventListener('click', applyCustomPrice)
    for (const input of [priceMin, priceMax]) {
      input.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return
        event.preventDefault()
        applyCustomPrice()
      })
    }

    root.querySelectorAll<HTMLElement>('[data-clear-group]').forEach((button) => {
      button.addEventListener('click', () => {
        removers[button.dataset.clearGroup as FacetGroup]()
        apply()
      })
    })

    root.querySelectorAll('[data-clear-all]').forEach((button) => {
      button.addEventListener('click', () => {
        query = { ...queryFromParams(new URLSearchParams()), sort: query.sort }
        normalizeNear()
        apply()
      })
    })

    sortSelect.addEventListener('change', () => {
      const sort = sortSelect.value as SortKey
      // "Más cercanos" sin un punto elegido: primero se pide la ubicación
      if (sort === 'cercania' && !originOf(query.near)) {
        sortSelect.value = query.sort
        void locate()
        return
      }
      query.sort = sort
      apply()
    })

    // ---------- "Cerca de": ubicación del navegador o un lugar de la lista ----------
    /** Aviso bajo la barra de resultados. Con `pickPlace` suma el botón para elegir un lugar. */
    const showStatus = (message: string, pickPlace = false) => {
      const text = document.createElement('p')
      text.textContent = message
      nearStatus.replaceChildren(text)
      if (!pickPlace) return
      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'near-status-action'
      button.textContent = 'Elegir un lugar'
      button.addEventListener('click', () => {
        if (!desktop.matches) open()
        nearSelect.focus()
      })
      nearStatus.append(button)
    }
    const clearStatus = () => nearStatus.replaceChildren()

    const chooseNear = (near: string) => {
      query.near = near
      query.sort = 'cercania'
      clearStatus()
      apply()
    }
    function clearNear() {
      query.near = undefined
      normalizeNear()
    }

    nearSelect.addEventListener('change', () => {
      if (nearSelect.value) chooseNear(nearSelect.value)
      else {
        clearNear()
        apply()
      }
    })

    const setLocating = (locating: boolean) => {
      locateButton.disabled = locating
      locateLabel.textContent = locating ? 'Buscando tu ubicación…' : 'Usar mi ubicación'
    }
    const locate = () =>
      new Promise<boolean>((resolve) => {
        if (!('geolocation' in navigator)) {
          showStatus('Tu navegador no comparte la ubicación. Elige un lugar de la lista.', true)
          return resolve(false)
        }
        setLocating(true)
        showStatus('Buscando tu ubicación…')
        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            setLocating(false)
            const point = { lat: coords.latitude, lng: coords.longitude }
            if (!isNearLima(point)) {
              showStatus(
                'Parece que no estás en Lima. Elige un lugar de la lista para ver los inmuebles más cercanos.',
                true,
              )
              return resolve(false)
            }
            myPosition = point
            if (!nearSelect.querySelector(`option[value="${MY_LOCATION}"]`))
              nearSelect.options[0]!.after(new Option('Mi ubicación', MY_LOCATION))
            chooseNear(MY_LOCATION)
            resolve(true)
          },
          (error) => {
            setLocating(false)
            showStatus(
              error.code === error.PERMISSION_DENIED
                ? 'No tenemos permiso para usar tu ubicación. Elige un lugar de la lista.'
                : 'No pudimos encontrar tu ubicación. Elige un lugar de la lista.',
              true,
            )
            resolve(false)
          },
          { timeout: 10_000, maximumAge: 300_000 },
        )
      })
    locateButton.addEventListener('click', () => void locate())

    // El buscador filtra mientras se escribe; "Buscar" solo cierra el teclado en el celular
    let typing = 0
    searchInput.addEventListener('input', () => {
      window.clearTimeout(typing)
      typing = window.setTimeout(() => {
        query.q = searchInput.value
        apply()
      }, 150)
    })
    searchForm.addEventListener('submit', (event) => {
      event.preventDefault()
      query.q = searchInput.value
      searchInput.blur()
      apply()
    })

    // ---------- Panel de filtros en móvil ----------
    const panel = $<HTMLElement>('[data-filters]')
    const backdrop = $<HTMLElement>('[data-filters-backdrop]')
    const openButton = $<HTMLButtonElement>('[data-filters-open]')
    const desktop = window.matchMedia('(min-width: 1024px)')
    const open = () => {
      panel.classList.add('is-open')
      backdrop.hidden = false
      openButton.setAttribute('aria-expanded', 'true')
      document.documentElement.classList.add('menu-open')
      $<HTMLElement>('[data-filters-title]').focus()
    }
    const close = () => {
      if (!panel.classList.contains('is-open')) return
      panel.classList.remove('is-open')
      backdrop.hidden = true
      openButton.setAttribute('aria-expanded', 'false')
      document.documentElement.classList.remove('menu-open')
      openButton.focus()
    }
    openButton.addEventListener('click', open)
    backdrop.addEventListener('click', close)
    root.querySelectorAll('[data-filters-close]').forEach((b) => b.addEventListener('click', close))
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close()
    })
    desktop.addEventListener('change', (event) => {
      if (event.matches) close()
    })

    setView(view)
    render()
    if (view === 'mapa') void showMap()
  }
</script>

