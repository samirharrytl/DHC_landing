---
// "Todos los inmuebles": la búsqueda completa de Capital, en su versión básica (buscador, orden y páginas).
// Todos los inmuebles (de propietarios y de proyectos) salen del build; el buscador y el orden se aplican
// en el navegador (lógica en src/lib/catalog-search.ts) y quedan en la URL (?q=lince&orden=precio-asc),
// así la búsqueda se puede compartir.
// La lista va en páginas de 12 (?pagina=2): cada página queda en el historial, así "Atrás" vuelve a la anterior.
// Por ahora no van los filtros de la barra lateral, "Cerca de" ni el mapa (siguen en el historial de git).
import BaseLayout from '../../layouts/BaseLayout.astro'
import Icon from '../../components/Icon.astro'
import PropertyCard from '../../components/PropertyCard.astro'
import { getProperties } from '../../lib/properties'
import { SORT_OPTIONS } from '../../lib/catalog-search'

const depas = await getProperties()
// "Más cercanos" necesita "Cerca de", que por ahora no está
const sortOptions = SORT_OPTIONS.filter((option) => option.value !== 'cercania')
---

<BaseLayout
  title="Todos los inmuebles"
  description="Todos los inmuebles para invertir en Lima de DepaHost Capital: busca por distrito, dirección, inmobiliaria o precio."
>
  <div class="container results-page" data-depa-search>
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/capital">Capital</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Todos los inmuebles</span>
    </nav>

    <header class="results-head">
      <h1 class="display">Todos los inmuebles</h1>
      <form class="search" role="search" data-search-form>
        <Icon name="search" size={22} class="search-icon" />
        <input
          type="search"
          name="q"
          placeholder="Busca por distrito, dirección, inmobiliaria o precio"
          aria-label="Buscar inmuebles"
          autocomplete="off"
          data-search-input
        />
        <button type="submit" class="btn btn--cta search-button">
          Buscar
        </button>
      </form>
    </header>

    <div class="results-bar">
      <p class="results-count" data-results-count role="status" aria-live="polite">
        {depas.length} resultados
      </p>
      <label class="sort">
        <span>Ordenar por</span>
        <select data-sort>
          {sortOptions.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </label>
    </div>

    <section class="results" aria-labelledby="results-title">
      <h2 id="results-title" class="sr-only" tabindex="-1" data-results-title>
        Resultados
      </h2>
      <div class="results-grid" data-results data-paging-pending>
        {depas.map((d, index) => (
          <PropertyCard property={d} priority={index < 3} />
        ))}
      </div>
      <!-- Páginas de 12: los números y los links los arma el script según los resultados -->
      <nav class="pagination" aria-label="Páginas de resultados" data-pagination hidden>
        <p class="pagination-info" data-pagination-info></p>
        <div class="pagination-pages">
          <!-- Sin página vecina es un texto gris; con página, el script lo cambia por un link -->
          <span class="pagination-step" data-page-step="-1" aria-disabled="true">
            <Icon name="arrow-left" size={18} />
            <span class="pagination-step-label">Anterior</span>
          </span>
          <ul class="pagination-list" data-page-list></ul>
          <span class="pagination-step" data-page-step="1" aria-disabled="true">
            <span class="pagination-step-label">Siguiente</span>
            <Icon name="arrow-right" size={18} />
          </span>
        </div>
      </nav>
      <div class="empty" data-results-empty hidden>
        <Icon name="search" size={28} />
        <p>No encontramos inmuebles con esa búsqueda.</p>
        <button type="button" class="btn btn--secondary btn--sm" data-clear-search>
          Limpiar búsqueda
        </button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    emptyQuery,
    matchesQuery,
    pageNumbers,
    paginate,
    queryFromParams,
    queryToParams,
    sortDepas,
    type DepaQuery,
    type PageSlice,
    type SearchableDepa,
    type SortKey,
  } from '../../lib/catalog-search'

  const root = document.querySelector<HTMLElement>('[data-depa-search]')
  if (root) {
    const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector)!
    const grid = $<HTMLElement>('[data-results]')
    const searchForm = $<HTMLFormElement>('[data-search-form]')
    const searchInput = $<HTMLInputElement>('[data-search-input]')
    const sortSelect = $<HTMLSelectElement>('[data-sort]')
    const count = $<HTMLElement>('[data-results-count]')
    const empty = $<HTMLElement>('[data-results-empty]')
    const resultsBar = $<HTMLElement>('.results-bar')
    const resultsTitle = $<HTMLElement>('[data-results-title]')
    const pagination = $<HTMLElement>('[data-pagination]')
    const paginationInfo = $<HTMLElement>('[data-pagination-info]')
    const pageList = $<HTMLUListElement>('[data-page-list]')
    let pageSteps = [...root.querySelectorAll<HTMLElement>('[data-page-step]')]

    type Item = SearchableDepa & { card: HTMLElement }
    const items: Item[] = [...grid.querySelectorAll<HTMLElement>('[data-property-card]')].map(
      (card, order) => ({
        card,
        order,
        id: card.dataset.id ?? '',
        districtSlug: card.dataset.district ?? '',
        origin: card.dataset.origin === 'developer' ? 'developer' : 'owner',
        developerSlug: card.dataset.developer ?? null,
        price: Number(card.dataset.price),
        yieldMin: Number(card.dataset.yieldMin),
        yieldMax: Number(card.dataset.yieldMax),
        paybackYears: Number(card.dataset.payback),
        status: (card.dataset.status ?? 'published') as SearchableDepa['status'],
        searchText: card.dataset.search ?? '',
      }),
    )

    /** De la URL solo cuentan el buscador y el orden: los links con filtros de antes muestran todo */
    const readQuery = (params: URLSearchParams): DepaQuery => {
      const { q, sort } = queryFromParams(params)
      return { ...emptyQuery(), q, sort: sort === 'cercania' ? 'destacados' : sort }
    }
    let query = readQuery(new URLSearchParams(location.search))
    // Lo que se escribió antes de que cargara este script (conexión lenta) también cuenta
    if (searchInput.value) query.q = searchInput.value
    /** Página de la lista (desde 1). Si pasa de las que hay, render la lleva a la última. */
    let page = Number(new URLSearchParams(location.search).get('pagina')) || 1

    /** La búsqueda actual en una página: para la barra de direcciones y los links de la paginación */
    const urlFor = (target: number) => {
      const params = queryToParams(query)
      if (target > 1) params.set('pagina', String(target))
      const search = params.toString()
      return search ? `${location.pathname}?${search}` : location.pathname
    }

    /** "Mostrando 13–24 de 36 inmuebles", los números y Anterior / Siguiente */
    const renderPagination = (slice: PageSlice, total: number) => {
      const paged = slice.pages > 1
      pagination.hidden = !paged
      resultsTitle.textContent = paged ? `Resultados, página ${slice.page} de ${slice.pages}` : 'Resultados'
      if (!paged) return
      paginationInfo.textContent = `Mostrando ${slice.start + 1}–${slice.end} de ${total} inmuebles`
      pageList.replaceChildren(
        ...pageNumbers(slice.page, slice.pages).map((target) => {
          const li = document.createElement('li')
          if (target === null) {
            li.className = 'pagination-gap'
            li.textContent = '…'
            li.setAttribute('aria-hidden', 'true')
            return li
          }
          const link = document.createElement('a')
          link.href = urlFor(target)
          link.dataset.page = String(target)
          link.textContent = String(target)
          link.setAttribute('aria-label', `Página ${target}`)
          if (target === slice.page) link.setAttribute('aria-current', 'page')
          li.append(link)
          return li
        }),
      )
      // En la primera no hay "Anterior" ni en la última "Siguiente": quedan grises, sin link
      pageSteps = pageSteps.map((step) => {
        const offset = Number(step.dataset.pageStep)
        const target = slice.page + offset
        let next: HTMLElement
        if (target >= 1 && target <= slice.pages) {
          const link = document.createElement('a')
          link.href = urlFor(target)
          link.rel = offset < 0 ? 'prev' : 'next'
          link.dataset.page = String(target)
          next = link
        } else {
          next = document.createElement('span')
          next.setAttribute('aria-disabled', 'true')
        }
        next.className = step.className
        next.dataset.pageStep = step.dataset.pageStep
        next.append(...step.childNodes)
        step.replaceWith(next)
        return next
      })
    }

    const render = () => {
      // Resultados: los que coinciden, en el orden elegido; el resto queda oculto al final.
      // A la vista, solo los de la página actual.
      const visible = sortDepas(
        items.filter((d) => matchesQuery(d, query)),
        query.sort,
      )
      const slice = paginate(visible.length, page)
      page = slice.page
      const onPage = new Set(visible.slice(slice.start, slice.end))
      for (const item of items) item.card.hidden = !onPage.has(item)
      const shown = new Set(visible)
      grid.append(
        ...visible.map((item) => item.card),
        ...items.filter((i) => !shown.has(i)).map((i) => i.card),
      )
      delete grid.dataset.pagingPending
      renderPagination(slice, visible.length)

      const total = visible.length
      count.textContent = `${total} ${total === 1 ? 'resultado' : 'resultados'}${query.q.trim() ? ` para "${query.q.trim()}"` : ''}`
      empty.hidden = total > 0
      if (document.activeElement !== searchInput) searchInput.value = query.q
      sortSelect.value = query.sort

      // La URL guarda la búsqueda y la página (para compartirla o volver con "Atrás")
      history.replaceState(null, '', urlFor(page))
    }
    /** Cambió la búsqueda (buscador u orden): vuelve a la primera página */
    const apply = () => {
      page = 1
      render()
    }

    // ---------- Eventos ----------
    sortSelect.addEventListener('change', () => {
      query.sort = sortSelect.value as SortKey
      apply()
    })

    $('[data-clear-search]').addEventListener('click', () => {
      query.q = ''
      searchInput.value = ''
      apply()
      searchInput.focus()
    })

    // El buscador filtra mientras se escribe; "Buscar" solo cierra el teclado en el celular
    let typing = 0
    searchInput.addEventListener('input', () => {
      window.clearTimeout(typing)
      typing = window.setTimeout(() => {
        query.q = searchInput.value
        apply()
      }, 150)
    })
    searchForm.addEventListener('submit', (event) => {
      event.preventDefault()
      query.q = searchInput.value
      searchInput.blur()
      apply()
    })

    // ---------- Páginas ----------
    /** Sube al inicio de los resultados, sin que los tape el header */
    const scrollToResults = () => {
      const header = document.querySelector<HTMLElement>('[data-header]')?.offsetHeight ?? 0
      window.scrollTo({ top: resultsBar.getBoundingClientRect().top + window.scrollY - header - 16 })
    }
    /** Cada página es una entrada del historial: "Atrás" vuelve a la anterior */
    const goToPage = (target: number) => {
      if (target === page) return
      page = target
      history.pushState(null, '', urlFor(page))
      render()
      // El foco pasa a "Resultados, página 2 de 3": el lector de pantalla empieza por la página nueva
      resultsTitle.focus({ preventScroll: true })
      scrollToResults()
    }
    pagination.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-page]')
      // Ctrl/Cmd + clic abre la página en otra pestaña, como cualquier link
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return
      event.preventDefault()
      goToPage(Number(link.dataset.page))
    })
    // "Atrás" y "Adelante": la búsqueda y la página salen de la URL de esa entrada
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(location.search)
      query = readQuery(params)
      page = Number(params.get('pagina')) || 1
      render()
    })

    render()
  }
</script>

<style>
  .results-page {
    padding-block: var(--space-4) var(--space-12);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .breadcrumb a {
    color: var(--color-navy-800);
  }

  /* ---------- Cabecera y buscador ---------- */
  .results-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* no crecer más que la pantalla */
    gap: var(--space-4);
  }
  .results-head h1 {
    font-size: clamp(2rem, 1.5rem + 1.8vw, 2.875rem);
    color: var(--color-navy-800);
  }
  .search {
    position: relative;
    display: flex;
    gap: var(--space-2);
  }
  .search input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 14px 0 calc(var(--space-3) + 22px + var(--space-2));
    border: 1px solid var(--color-border-input);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--color-text);
    font-size: 16px; /* evita el zoom de iOS */
  }
  .search input:focus-visible {
    border-color: var(--color-navy-800);
  }
  .search :global(.search-icon) {
    position: absolute;
    top: 50%;
    left: var(--space-3);
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .search-button {
    flex: none;
    padding-inline: var(--space-5);
  }

  /* ---------- Barra de resultados: cantidad y orden ---------- */
  .results-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding: var(--space-2) 0;
    border-block: var(--border-subtle);
  }
  .results-count {
    margin: 0;
    font-weight: var(--fw-semibold);
    color: var(--color-text-strong);
  }
  .sort {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .sort select {
    min-height: var(--control-h-sm);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border-input);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    color: var(--color-text);
    font-size: var(--fs-sm);
  }
  /* Celular: el select ya dice cómo ordena; "Ordenar por" queda para lectores de pantalla */
  @media (max-width: 639px) {
    .results-count {
      font-size: var(--fs-sm);
    }
    .sort span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }

  /* ---------- Resultados ---------- */
  .results {
    margin-top: var(--space-5);
  }
  .results-grid {
    display: grid;
    gap: var(--grid-gap);
  }
  /* Antes de que corra el script: solo la primera página, sin salto al cargar (13 = PAGE_SIZE + 1) */
  .results-grid[data-paging-pending] :global(article[data-property-card]:nth-of-type(n + 13)) {
    display: none;
  }

  /* ---------- Paginación ---------- */
  .pagination {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .pagination[hidden] {
    display: none;
  }
  .pagination-info {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
  .pagination-pages,
  .pagination-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .pagination-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pagination-step,
  .pagination-list :global(a) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: var(--control-h-sm);
    min-height: var(--control-h-sm);
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border-input);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--color-navy-800);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }
  .pagination-step {
    padding-inline: var(--space-4);
  }
  @media (hover: hover) {
    .pagination-step[href]:hover,
    .pagination-list :global(a:hover) {
      border-color: var(--color-navy-800);
      background: var(--color-navy-50);
    }
  }
  .pagination-list :global(a[aria-current='page']) {
    border-color: var(--color-navy-800);
    background: var(--color-navy-800);
    color: #fff;
  }
  .pagination-step[aria-disabled='true'] {
    border-color: var(--color-border-subtle);
    color: var(--color-disabled-text);
    cursor: default;
  }
  .pagination-list :global(.pagination-gap) {
    min-width: var(--space-6);
    color: var(--color-text-muted);
    text-align: center;
  }
  /* Celular: los números arriba y "Anterior" / "Siguiente" abajo, mitad y mitad, a mano del pulgar */
  @media (max-width: 639px) {
    .pagination-pages {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3) var(--space-2);
      width: 100%;
    }
    .pagination-list {
      grid-column: 1 / -1;
      justify-content: center;
    }
    .pagination-step[data-page-step='-1'] {
      grid-area: 2 / 1;
    }
    .pagination-step[data-page-step='1'] {
      grid-area: 2 / 2;
    }
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-navy-800);
  }
  .empty[hidden] {
    display: none;
  }
  .empty p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .results-head {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: var(--space-8);
    }
    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .results-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
