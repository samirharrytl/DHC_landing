---
import BaseLayout from '../layouts/BaseLayout.astro'
import Button from '../components/Button.astro'
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="container section not-found">
    <p class="code" aria-hidden="true">
      404
    </p>
    <h1>No encontramos esta página</h1>
    <p class="lead">Puede que el depa ya no esté disponible o que el link tenga un error.</p>
    <div class="btn-group actions">
      <Button href="/capital">Ver depas para invertir</Button>
      <Button href="/" variant="outline">
        Ir al inicio
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
  }
  .code {
    margin: 0;
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--color-navy-100);
  }
  .actions {
    justify-content: center;
    margin-top: var(--space-6);
  }
</style>
