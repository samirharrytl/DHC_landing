---
// Franja de inmobiliarias aliadas. Las que tienen proyectos publicados llevan a su página.
// Mientras no haya logos con permiso de uso, se muestra el nombre como marca tipográfica.
import type { Developer } from '../types/property'

interface Props {
  developers: Developer[]
  title?: string
  id?: string
}
const { developers, title = 'Aliados', id = 'aliados' } = Astro.props
const headingId = `${id}-title`
---

{developers.length > 0 && (
  <section id={id} class="container allies" aria-labelledby={headingId}>
    <h2 id={headingId} class="allies-title">
      {title}
    </h2>
    <ul class="allies-list">
      {developers.map((d) => (
        <li>
          {d.projectCount > 0 ? (
            <a href={`/capital/aliados/${d.slug}`} class="ally">
              <span class="ally-name">{d.name}</span>
              <span class="ally-count">
                {d.projectCount} {d.projectCount === 1 ? 'proyecto' : 'proyectos'}
              </span>
            </a>
          ) : (
            <span class="ally ally--soon">
              <span class="ally-name">{d.name}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .allies {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-10);
    border-top: var(--border-subtle);
  }
  .allies-title {
    font-size: var(--fs-13);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .allies-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ally {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
    min-height: 64px;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    text-align: center;
    text-decoration: none;
  }
  a.ally {
    color: var(--color-navy-800);
  }
  a.ally:hover {
    background: var(--color-navy-50);
  }
  .ally-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .ally-count {
    font-size: var(--fs-xs);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }
  .ally--soon {
    opacity: 0.6;
  }
  @media (min-width: 640px) {
    .allies-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .allies {
      grid-template-columns: 9rem 1fr;
      align-items: center;
    }
    .allies-list {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
    }
  }
</style>
