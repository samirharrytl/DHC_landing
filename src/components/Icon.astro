---
// Íconos de línea del sitio: un solo trazo (1.6) y caja de 24×24 para que todos se vean de la misma
// familia. Son decorativos (aria-hidden): el texto de al lado dice qué significan.
import { ICONS, type IconName } from '../lib/icons'

interface Props {
  name: IconName
  size?: number
  class?: string
  strokeWidth?: number
}

const { name, size = 20, class: className, strokeWidth = 1.6 } = Astro.props
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {ICONS[name].map((d) => (
    <path d={d} />
  ))}
</svg>
