---
// Footer compartido: banda navy con llamada a WhatsApp + fila legal
import Logo from './Logo.astro'
import Button from './Button.astro'
import { waLink } from '../data/contacto'
import { COMPANY } from '../data/empresa'

const year = new Date().getFullYear()
const legalLinks = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/privacidad', label: 'Política de privacidad' },
  { href: '/terminos', label: 'Términos' },
  { href: '/libro-de-reclamaciones', label: 'Libro de Reclamaciones' },
]
---

<footer class="footer">
  <!-- data-footer-cta: cuando esta banda se ve, se esconde el WhatsApp flotante -->
  <div class="band" data-footer-cta>
    <div class="container band-inner">
      <Logo inverse />
      <div class="band-text">
        <p class="title">Cuéntanos qué quieres hacer con tu propiedad.</p>
        <p class="sub">
          Te ayudamos a venderla en el menor tiempo o a encontrar la que te genere renta. Te respondemos por
          WhatsApp.
        </p>
      </div>
      <Button href={waLink('Hola, les cuento qué quiero hacer con mi inmueble.')} class="band-btn">
        Escribir por WhatsApp
      </Button>
    </div>
  </div>

  <div class="legal">
    <div class="container legal-inner">
      <nav aria-label="Legal">
        <ul>
          {legalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p>
        © {year} Depa Host Perú · RUC {COMPANY.ruc} · depahostperu.com ·{' '}
        <button type="button" class="link-button" data-consent-open>
          Preferencias de cookies
        </button>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-900);
    color: #fff;
  }

  /* ---------- Banda CTA ---------- */
  .band {
    padding-block: var(--space-8);
  }
  .band-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }
  .title {
    margin: 0;
    font-size: var(--fs-20);
    font-weight: var(--fw-semibold);
    text-wrap: balance; /* líneas parejas, sin una palabra sola al final */
  }
  .sub {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-15);
    color: var(--color-text-inverse-muted);
    text-wrap: balance;
  }
  .band-inner :global(.band-btn) {
    width: 100%;
  }

  @media (min-width: 640px) {
    .band-inner :global(.band-btn) {
      width: auto;
    }
  }
  @media (min-width: 1024px) {
    .band {
      padding-block: var(--space-6);
      min-height: 96px;
      display: flex;
      align-items: center;
    }
    .band-inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-8);
    }
    .title {
      font-size: var(--fs-22);
    }
  }

  /* ---------- Fila legal ---------- */
  .legal {
    border-top: 1px solid rgb(255 255 255 / 0.12);
    padding-block: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-text-inverse-muted);
  }
  .legal-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .legal ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legal a {
    display: flex;
    align-items: center;
    min-height: var(--control-h-sm); /* 44px en móvil */
    color: #fff;
    text-decoration: none;
  }
  .legal a:hover {
    text-decoration: underline;
  }
  .legal p {
    margin: 0;
    padding-block: var(--space-2);
  }
  .link-button {
    min-height: var(--control-h-sm);
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .link-button:hover {
    text-decoration: underline;
  }

  @media (min-width: 1024px) {
    .legal-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .legal ul {
      flex-direction: row;
      gap: var(--space-6);
    }
  }
</style>
