---
// Widget anti-spam de Cloudflare Turnstile. Agrega al formulario un campo oculto
// "cf-turnstile-response" que la API verifica. Sin PUBLIC_TURNSTILE_SITE_KEY no se muestra nada.
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client'

interface Props {
  theme?: 'light' | 'dark' | 'auto'
}
const { theme = 'light' } = Astro.props
---

{PUBLIC_TURNSTILE_SITE_KEY && (
  <>
    <div
      class="cf-turnstile"
      data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
      data-theme={theme}
      data-language="es"
    />
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  </>
)}
