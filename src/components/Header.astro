---
// Header compartido: logo, menú, ES | EN y WhatsApp.
// En pantallas chicas (<1024px) el menú se abre en un panel lateral (drawer).
import Logo from './Logo.astro'
import LangSwitch from './LangSwitch.astro'
import WhatsAppIcon from './WhatsAppIcon.astro'
import CartIcon from './CartIcon.astro'
import { waLink } from '../data/contacto'

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/estadias', label: 'Estadías' },
  { href: '/propietarios', label: 'Propietarios' },
  { href: '/capital', label: 'Capital' },
  { href: '/nosotros', label: 'Nosotros' },
]

// Quitamos la "/" final para comparar: "/capital/" → "/capital"
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const whatsapp = waLink('Hola, les escribo desde la web de Depa Host Perú.')
---
<header class="header" data-header>
  <div class="container bar">
    <Logo />

    <!-- Menú de escritorio (≥1024px) -->
    <nav class="nav" aria-label="Principal">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined} data-astro-prefetch>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <div class="lang-wrap"><LangSwitch /></div>

      <!-- Ingresar: oculto en móvil (no cabe junto al logo + carrito + hamburguesa) -->
      <a class="btn btn--secondary btn--sm login" href="/ingresar">Ingresar</a>

      <!-- WhatsApp: solo ícono en tablet, completo en escritorio, oculto en móvil (ahí está el flotante) -->
      <a class="btn btn--whatsapp btn--sm wa" href={whatsapp} target="_blank" rel="noopener noreferrer">
        <WhatsAppIcon />
        <!-- sr-only: en tablet solo se ve el ícono; desde 1024px se muestra el texto -->
        <span class="sr-only wa-label">WhatsApp</span>
      </a>

      <!-- Carrito: ícono siempre visible. TODO: la página /carrito todavía no existe -->
      <a class="cart" href="/carrito" aria-label="Carrito de compras">
        <CartIcon />
        <!-- Badge de cantidad: aparece cuando haya items (por ahora oculto con el atributo hidden) -->
        <span class="cart-count" data-cart-count hidden>0</span>
      </a>

      <!-- Botón hamburguesa (<1024px) -->
      <button
        type="button"
        class="burger"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Drawer móvil. <dialog> trae gratis: foco atrapado adentro y cierre con Esc -->
<dialog id="nav-drawer" class="drawer" aria-label="Menú">
  <div class="drawer-panel">
    <div class="drawer-top">
      <Logo />
      <button type="button" class="burger" aria-label="Cerrar menú" data-menu-close>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <nav aria-label="Principal (móvil)">
      <ul class="drawer-links">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined} data-astro-prefetch>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="drawer-bottom">
      <LangSwitch />
      <a class="btn btn--whatsapp btn--block" href={whatsapp} target="_blank" rel="noopener noreferrer">
        <WhatsAppIcon />
        WhatsApp
      </a>
    </div>
  </div>
</dialog>

<!-- Botón flotante de WhatsApp (solo móvil <640px) -->
<a class="fab" href={whatsapp} target="_blank" rel="noopener noreferrer"
   aria-label="Escríbenos por WhatsApp" data-fab>
  <WhatsAppIcon size={28} />
</a>

<script>
  // ---------- Sombra del header al hacer scroll ----------
  // En vez de leer window.scrollY (obliga al navegador a recalcular la página),
  // observamos una marca invisible arriba de todo: si ya no se ve, bajamos más de 8px.
  const header = document.querySelector<HTMLElement>('[data-header]')
  const sentinel = document.querySelector('[data-scroll-sentinel]')
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry.isIntersecting)
    }).observe(sentinel)
  }

  // ---------- Menú móvil (drawer) ----------
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const drawer = document.querySelector<HTMLDialogElement>('#nav-drawer')
  const closeButton = drawer?.querySelector<HTMLButtonElement>('[data-menu-close]')

  if (toggle && drawer) {
    const openMenu = () => {
      drawer.showModal() // abre como modal: el resto de la página queda inactivo
      closeButton?.focus() // el foco entra al panel
      toggle.setAttribute('aria-expanded', 'true')
      toggle.setAttribute('aria-label', 'Cerrar menú')
      document.documentElement.classList.add('menu-open') // bloquea el scroll y oculta el flotante
    }

    const closeMenu = () => drawer.close()

    // Se dispara siempre al cerrar (botón ✕, Esc o clic en el fondo)
    drawer.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false')
      toggle.setAttribute('aria-label', 'Abrir menú')
      document.documentElement.classList.remove('menu-open')
      toggle.focus() // el foco vuelve a la hamburguesa
    })

    toggle.addEventListener('click', openMenu)
    closeButton?.addEventListener('click', closeMenu)

    // Clic en el fondo oscuro: el clic cae en el <dialog> mismo, no en el panel
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) closeMenu()
    })

    // Si la pantalla crece a escritorio con el menú abierto, lo cerramos
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && drawer.open) closeMenu()
    })
  }

  // ---------- Botón flotante de WhatsApp ----------
  // Aparece después de pasar el hero y se esconde cuando se ve la banda del footer
  const fab = document.querySelector<HTMLElement>('[data-fab]')
  const hero = document.querySelector('[data-hero]')
  const footerCta = document.querySelector('[data-footer-cta]')
  let heroVisible = Boolean(hero) // páginas sin hero: el flotante se muestra desde el inicio
  let footerVisible = false

  const updateFab = () => fab?.classList.toggle('is-visible', !heroVisible && !footerVisible)

  if (fab && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === hero) heroVisible = entry.isIntersecting
        if (entry.target === footerCta) footerVisible = entry.isIntersecting
      }
      updateFab()
    })
    if (hero) observer.observe(hero)
    if (footerCta) observer.observe(footerCta)
    updateFab()
  } else {
    fab?.classList.add('is-visible')
  }
</script>

<style>
  /* ---------- Barra ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: #fff;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .header.is-scrolled { box-shadow: var(--shadow-header); }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  /* ---------- Menú de escritorio ---------- */
  .nav { display: none; }
  .nav ul {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a,
  .drawer-links a {
    color: var(--color-text);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h-sm); /* área táctil de 44px */
  }
  .nav a:hover,
  .drawer-links a:hover { color: var(--color-navy-800); }

  /* Página actual: más gruesa y subrayada */
  .nav a[aria-current='page'],
  .drawer-links a[aria-current='page'] {
    color: var(--color-navy-800);
    font-weight: var(--fw-semibold);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  /* ---------- Acciones ---------- */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .lang-wrap { display: none; }
  .wa { display: none; }

  /* "Ingresar": oculto en móvil (no cabe junto al logo + carrito + hamburguesa) */
  .login { display: none; }

  /* Carrito: botón de ícono como la hamburguesa, con badge de cantidad */
  .cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border-radius: var(--radius-md);
    color: var(--color-navy-800);
  }
  .cart:hover { background: var(--color-navy-50); }
  .cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--color-navy-800);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    line-height: 1;
  }
  /* el atributo hidden gana sobre el display:flex del badge */
  .cart-count[hidden] { display: none; }

  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-navy-800);
    cursor: pointer;
  }
  .burger:hover { background: var(--color-navy-50); }

  /* Tablet: aparece ES | EN y WhatsApp solo ícono */
  @media (min-width: 640px) {
    .lang-wrap { display: block; }
    .login { display: inline-flex; }
    .wa { display: inline-flex; width: var(--control-h-sm); padding: 0; }
  }

  /* Escritorio: menú en línea, WhatsApp completo, sin hamburguesa */
  @media (min-width: 1024px) {
    .nav { display: block; }
    .wa { width: auto; padding: 0 var(--space-4); }
    /* deshace el .sr-only para que el texto "WhatsApp" se vea */
    .wa-label { position: static; width: auto; height: auto; margin: 0; overflow: visible; clip: auto; }
    .actions .burger { display: none; }
  }
  @media (min-width: 1280px) {
    .nav ul { gap: var(--space-8); }
  }

  /* ---------- Drawer ---------- */
  .drawer {
    position: fixed;
    inset: 0 0 0 auto; /* pegado a la derecha */
    width: min(320px, 85vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--color-text);
  }
  .drawer::backdrop { background: var(--color-overlay); }
  .drawer[open] { animation: drawer-in var(--dur-slow) var(--ease-out); }

  @keyframes drawer-in {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .drawer-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-4);
    overflow-y: auto;
  }
  .drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .drawer-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .drawer-links li + li { border-top: var(--border-subtle); }
  .drawer-links a {
    display: flex;
    align-items: center;
    min-height: var(--control-h-md); /* 48px */
    font-size: var(--fs-18);
  }

  .drawer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-6);
  }

  /* ---------- Botón flotante (FAB) ---------- */
  .fab {
    position: fixed;
    right: var(--space-4);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
    z-index: var(--z-fab);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--fab-size);
    height: var(--fab-size);
    border-radius: var(--radius-pill);
    background: var(--color-wa-700);
    color: #fff;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out),
                visibility var(--dur-base);
  }
  .fab:hover { background: var(--color-wa-800); }
  .fab.is-visible { opacity: 1; visibility: visible; transform: none; }
  :global(html.menu-open) .fab { display: none; }
  @media (min-width: 640px) { .fab { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .drawer[open] { animation: none; }
    .fab { transform: none; }
  }
</style>
