---
// Header compartido: logo, menú, ES | EN y WhatsApp.
// En pantallas chicas (<1024px) el menú se abre en un panel lateral (drawer).
import Logo from './Logo.astro'
import LangSwitch from './LangSwitch.astro'
import WhatsAppIcon from './WhatsAppIcon.astro'
import CartIcon from './CartIcon.astro'
import Icon from './Icon.astro'
import { waLink } from '../data/contacto'
import { PUBLIC_LOGIN_ENABLED, PUBLIC_PANEL_URL } from 'astro:env/client'

// Menú principal: comprar (Capital y Mis inmuebles) y vender (Propietarios).
// `section`: páginas en las que el link queda marcado, aunque no sea la página exacta
const links = [
  { href: '/', label: 'Inicio', section: [] },
  { href: '/capital', label: 'Compra', section: ['/capital', '/mis-inmuebles'] },
  { href: '/propietarios', label: 'Vende', section: ['/propietarios'] },
]

// Quitamos la "/" final para comparar: "/capital/" → "/capital"
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
/** "page" en la página del link; "true" en el resto de su sección (/capital/inmuebles → Compra) */
const current = (link: (typeof links)[number]) =>
  path === link.href
    ? 'page'
    : link.section.some((s) => path === s || path.startsWith(`${s}/`))
      ? 'true'
      : undefined
const panelUrl = PUBLIC_PANEL_URL?.replace(/\/$/, '')
const whatsapp = waLink('Hola, les escribo desde la web de Depa Host Perú.')
---

<header class="header" data-header>
  <div class="container bar">
    <Logo />

    <!-- Menú de escritorio (≥1024px) -->
    <nav class="nav" aria-label="Principal">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link)} data-astro-prefetch>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <!-- Saludo: con la cuenta (lleva al panel) o con el nombre de "Guarda tus inmuebles" -->
      <a class="greeting" href="/mis-inmuebles" data-greeting data-panel-url={panelUrl} hidden>
        <span class="avatar" aria-hidden="true" data-greeting-initial></span>
        <span class="greeting-text">
          Hola, <span data-greeting-name></span>
        </span>
      </a>

      <!-- Ingresar al panel (solo si hay panel configurado y no hay sesión) -->
      {PUBLIC_LOGIN_ENABLED && panelUrl && (
        <a class="login" href={`${panelUrl}/ingresar`} data-login>
          <Icon name="lock" size={20} />
          <span class="login-text">Ingresar</span>
        </a>
      )}

      <!-- Acceso a los inmuebles guardados -->
      <a class="cart" href="/mis-inmuebles" aria-label="Mis inmuebles" data-cart-link>
        <CartIcon />
        <span class="cart-label">Mis inmuebles</span>
        <span class="cart-count" data-cart-count aria-hidden="true" hidden>
          0
        </span>
      </a>

      <!-- Botón de WhatsApp (desde 640px); en móvil está el botón flotante -->
      <a
        class="wa"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
      >
        <span class="wa-icon">
          <WhatsAppIcon size={20} />
        </span>
        <span class="wa-label">Contactar</span>
      </a>

      <!-- Botón hamburguesa (<1024px) -->
      <button
        type="button"
        class="burger"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Drawer móvil. <dialog> trae gratis: foco atrapado adentro y cierre con Esc -->
<dialog id="nav-drawer" class="drawer" aria-label="Menú">
  <div class="drawer-panel">
    <div class="drawer-top">
      <Logo />
      <button type="button" class="burger" aria-label="Cerrar menú" data-menu-close>
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <nav aria-label="Principal (móvil)">
      <ul class="drawer-links">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link)} data-astro-prefetch>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="drawer-bottom">
      {PUBLIC_LOGIN_ENABLED && panelUrl && (
        <a class="btn btn--secondary btn--block" href={`${panelUrl}/ingresar`} data-login-drawer>
          Ingresar a mi cuenta
        </a>
      )}
      <LangSwitch />
      <a class="btn btn--whatsapp btn--block" href={whatsapp} target="_blank" rel="noopener noreferrer">
        <WhatsAppIcon />
        WhatsApp
      </a>
    </div>
  </div>
</dialog>

<!-- Botón flotante de WhatsApp (solo móvil <640px) -->
<a
  class="fab"
  href={whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  data-fab
>
  <WhatsAppIcon size={28} />
</a>

<script>
  import { getSavedStore } from '../lib/saved-store'
  import { firstNameOf, getProfileStore, PROFILE_EVENT } from '../lib/profile'
  import { getAccount, syncSavedWithAccount } from '../lib/account'

  // ---------- Mis inmuebles: contador ----------
  // Los botones "Me interesa" viven en cada tarjeta (src/scripts/saved-buttons.ts); aquí solo el contador.
  const store = getSavedStore()
  const renderCount = (ids: string[]) => {
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((badge) => {
      badge.textContent = String(ids.length)
      badge.hidden = ids.length === 0
    })
    document.querySelectorAll<HTMLElement>('[data-cart-link]').forEach((link) => {
      const count = ids.length
        ? `, ${ids.length} ${ids.length === 1 ? 'inmueble guardado' : 'inmuebles guardados'}`
        : ''
      link.setAttribute('aria-label', `Mis inmuebles${count}`)
    })
  }
  store.subscribe(renderCount)
  renderCount(store.list())

  // ---------- Saludo e "Ingresar" ----------
  // Con sesión: "Hola, {nombre de la cuenta}" lleva al panel y se oculta "Ingresar".
  // Sin sesión: saludo con el nombre de "Guarda tus inmuebles", si lo dejó.
  const profile = getProfileStore()
  let accountName: string | undefined
  const renderGreeting = () => {
    const name = accountName ?? profile.get()?.firstName
    document.querySelectorAll<HTMLAnchorElement>('[data-greeting]').forEach((el) => {
      el.hidden = !name
      el.querySelector('[data-greeting-name]')!.textContent = name ?? ''
      el.querySelector('[data-greeting-initial]')!.textContent = name?.charAt(0) ?? ''
      if (accountName && el.dataset.panelUrl) el.href = el.dataset.panelUrl
    })
    document.querySelectorAll<HTMLElement>('[data-login], [data-login-drawer]').forEach((el) => {
      el.hidden = Boolean(accountName)
    })
  }
  window.addEventListener(PROFILE_EVENT, renderGreeting)
  renderGreeting()

  getAccount().then((user) => {
    if (!user) return
    accountName = firstNameOf(user.name)
    renderGreeting()
    void syncSavedWithAccount()
  })

  // ---------- Sombra del header al hacer scroll ----------
  // En vez de leer window.scrollY (obliga al navegador a recalcular la página),
  // observamos una marca invisible arriba de todo: si ya no se ve, bajamos más de 8px.
  const header = document.querySelector<HTMLElement>('[data-header]')
  const sentinel = document.querySelector('[data-scroll-sentinel]')
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      if (entry) header.classList.toggle('is-scrolled', !entry.isIntersecting)
    }).observe(sentinel)
  }

  // ---------- Menú móvil (drawer) ----------
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const drawer = document.querySelector<HTMLDialogElement>('#nav-drawer')
  const closeButton = drawer?.querySelector<HTMLButtonElement>('[data-menu-close]')

  if (toggle && drawer) {
    const openMenu = () => {
      drawer.showModal() // abre como modal: el resto de la página queda inactivo
      closeButton?.focus() // el foco entra al panel
      toggle.setAttribute('aria-expanded', 'true')
      toggle.setAttribute('aria-label', 'Cerrar menú')
      document.documentElement.classList.add('menu-open') // bloquea el scroll y oculta el flotante
    }

    const closeMenu = () => drawer.close()

    // Se dispara siempre al cerrar (botón ✕, Esc o clic en el fondo)
    drawer.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false')
      toggle.setAttribute('aria-label', 'Abrir menú')
      document.documentElement.classList.remove('menu-open')
      toggle.focus() // el foco vuelve a la hamburguesa
    })

    toggle.addEventListener('click', openMenu)
    closeButton?.addEventListener('click', closeMenu)

    // Clic en el fondo oscuro: el clic cae en el <dialog> mismo, no en el panel
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) closeMenu()
    })

    // Si la pantalla crece a escritorio con el menú abierto, lo cerramos
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && drawer.open) closeMenu()
    })
  }

  // ---------- Botón flotante de WhatsApp ----------
  // Aparece después de pasar el hero y se esconde cuando se ve la banda del footer
  const fab = document.querySelector<HTMLElement>('[data-fab]')
  const hero = document.querySelector('[data-hero]')
  const footerCta = document.querySelector('[data-footer-cta]')
  let heroVisible = Boolean(hero) // páginas sin hero: el flotante se muestra desde el inicio
  let footerVisible = false

  const updateFab = () => fab?.classList.toggle('is-visible', !heroVisible && !footerVisible)

  if (fab && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === hero) heroVisible = entry.isIntersecting
        if (entry.target === footerCta) footerVisible = entry.isIntersecting
      }
      updateFab()
    })
    if (hero) observer.observe(hero)
    if (footerCta) observer.observe(footerCta)
    updateFab()
  } else {
    fab?.classList.add('is-visible')
  }
</script>

<style>
  /* ---------- Barra ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: #fff;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .header.is-scrolled {
    box-shadow: var(--shadow-header);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  /* ---------- Menú de escritorio ---------- */
  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav li {
    display: flex;
    align-items: center;
  }
  .nav li + li::before {
    content: '|';
    margin-inline: var(--space-3);
    color: var(--color-text-muted);
    font-weight: var(--fw-regular);
  }

  .nav a,
  .drawer-links a {
    color: var(--color-text);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h-sm); /* área táctil de 44px */
    color: var(--color-text-muted);
    font-size: var(--fs-15);
  }
  .nav a:hover,
  .drawer-links a:hover {
    color: var(--color-navy-800);
  }

  /* Página actual: más gruesa y subrayada */
  .drawer-links a[aria-current] {
    color: var(--color-navy-800);
    font-weight: var(--fw-semibold);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .nav a[aria-current] {
    color: var(--color-text-muted);
  }
  .nav a[aria-current]::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 2px;
    background: var(--color-navy-800);
    content: '';
  }

  /* ---------- Acciones ---------- */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .wa {
    display: none;
  }

  .wa {
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-h-md);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-navy-850);
    border-radius: 10px;
    background: var(--color-navy-800);
    color: #fff;
    font-size: var(--fs-15);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .wa-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-wa-500);
    color: #fff;
  }
  .wa-icon svg {
    width: 20px;
    height: 20px;
    flex: none;
  }
  .wa-label {
    color: inherit;
  }
  .wa:hover {
    background: var(--color-navy-850);
  }
  .wa:active {
    transform: translateY(1px);
  }

  /* Saludo "Hola, Ana" (desde 640px) */
  .greeting {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h-sm);
    padding-right: var(--space-3);
    border-right: var(--border-subtle);
    color: var(--color-text);
    font-size: var(--fs-15);
    text-decoration: none;
    white-space: nowrap;
  }
  .greeting[hidden] {
    display: none !important;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--color-navy-800);
    border-radius: var(--radius-pill);
    color: var(--color-navy-800);
    font-weight: var(--fw-semibold);
  }

  /* "Ingresar" con candado (desde 640px; en móvil va en el menú) */
  .login {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h-sm);
    padding: 0 var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--fs-15);
    text-decoration: none;
    white-space: nowrap;
  }
  .login :global(svg) {
    color: var(--color-navy-800);
  }
  .login:hover {
    background: var(--color-navy-50);
  }
  .login[hidden] {
    display: none !important;
  }
  .drawer-bottom [hidden] {
    display: none;
  }

  /* Acceso a Mis inmuebles con icono de carpeta y contador */
  .cart {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 3.75rem;
    min-height: var(--control-h-sm);
    padding: 2px 4px 0;
    border-radius: var(--radius-md);
    color: var(--color-navy-800);
    text-decoration: none;
  }
  .cart svg {
    flex: none;
  }
  .cart-label {
    color: var(--color-text);
    font-size: var(--fs-xs);
    line-height: 1.2;
    white-space: nowrap;
  }
  .cart:hover {
    background: var(--color-navy-50);
  }
  .cart-count {
    position: absolute;
    top: -1px;
    right: 1px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--color-navy-800);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    line-height: 1;
  }
  /* el atributo hidden gana sobre el display:flex del badge */
  .cart-count[hidden] {
    display: none;
  }

  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-navy-800);
    cursor: pointer;
  }
  .burger:hover {
    background: var(--color-navy-50);
  }

  /* Tablet: aparece el botón de WhatsApp */
  @media (min-width: 640px) {
    .wa,
    .greeting,
    .login {
      display: inline-flex;
    }
  }

  /* Entre 1024 y 1279 px no caben menú, saludo y WhatsApp: saludo e "Ingresar" solo con ícono
     (el texto queda para lectores de pantalla) */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .greeting-text,
    .login-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
    .greeting {
      padding-right: var(--space-2);
    }
  }

  /* Escritorio: menú en línea sin hamburguesa */
  @media (min-width: 1024px) {
    .nav {
      display: block;
    }
    .actions .burger {
      display: none;
    }
  }
  @media (min-width: 1280px) {
    .nav li + li::before {
      margin-inline: var(--space-4);
    }
  }
  /* Pantallas grandes: el header crece a 88px para que el logo tenga presencia sin quedar apretado
     (ver Logo.astro). Es una variable global: los elementos fijos bajo el header se acomodan solos */
  @media (min-width: 1280px) {
    /* html:root pesa más que el :root de tokens.css, que se carga después */
    :global(html:root) {
      --header-h: 5.5rem;
    }
  }

  /* ---------- Drawer ---------- */
  .drawer {
    position: fixed;
    inset: 0 0 0 auto; /* pegado a la derecha */
    width: min(320px, 85vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--color-text);
  }
  .drawer::backdrop {
    background: var(--color-overlay);
  }
  .drawer[open] {
    animation: drawer-in var(--dur-slow) var(--ease-out);
  }

  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .drawer-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-4);
    overflow-y: auto;
  }
  .drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .drawer-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .drawer-links li + li {
    border-top: var(--border-subtle);
  }
  .drawer-links a {
    display: flex;
    align-items: center;
    min-height: var(--control-h-md); /* 48px */
    font-size: var(--fs-18);
  }

  .drawer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-6);
  }

  /* ---------- Botón flotante (FAB) ---------- */
  .fab {
    position: fixed;
    right: var(--space-4);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
    z-index: var(--z-fab);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--fab-size);
    height: var(--fab-size);
    border-radius: var(--radius-pill);
    background: var(--color-wa-700);
    color: #fff;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility var(--dur-base);
  }
  .fab:hover {
    background: var(--color-wa-800);
  }
  .fab.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  :global(html.menu-open) .fab {
    display: none;
  }
  @media (min-width: 640px) {
    .fab {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer[open] {
      animation: none;
    }
    .fab {
      transform: none;
    }
  }
</style>
