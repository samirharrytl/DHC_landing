---
// Aviso de cookies y analítica (Ley 29733 de Protección de Datos Personales).
// Microsoft Clarity solo se carga si la persona acepta. La elección se guarda en el navegador
// y se puede cambiar desde "Preferencias de cookies" en el footer.
---

<section class="consent" data-consent hidden aria-labelledby="consent-title">
  <div class="consent-inner">
    <div>
      <h2 id="consent-title" class="consent-title">
        Usamos cookies de analítica
      </h2>
      <p class="consent-text">
        Nos ayudan a entender cómo se usa la web para mejorarla. Solo las activamos si aceptas. Más detalles
        en nuestra <a href="/privacidad">política de privacidad</a>.
      </p>
    </div>
    <div class="consent-actions">
      <button type="button" class="btn btn--secondary btn--sm" data-consent-choice="denied">
        Rechazar
      </button>
      <button type="button" class="btn btn--primary btn--sm" data-consent-choice="granted">
        Aceptar
      </button>
    </div>
  </div>
</section>

<script>
  import { getConsent, loadAnalytics, setConsent, type Consent } from '../scripts/consent'

  const banner = document.querySelector<HTMLElement>('[data-consent]')

  if (getConsent() === 'granted') loadAnalytics()
  else if (getConsent() === null && banner) banner.hidden = false

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((button) => {
    button.addEventListener('click', () => {
      const choice = button.dataset.consentChoice as Consent
      setConsent(choice)
      if (choice === 'granted') loadAnalytics()
      banner.hidden = true
    })
  })

  // "Preferencias de cookies" (footer) vuelve a mostrar el aviso
  document.querySelectorAll('[data-consent-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!banner) return
      banner.hidden = false
      banner.querySelector<HTMLButtonElement>('[data-consent-choice="granted"]')?.focus()
    })
  })
</script>

<style>
  .consent {
    position: fixed;
    right: var(--space-4);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
    left: var(--space-4);
    z-index: var(--z-toast);
    max-width: 560px;
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-lg);
  }
  .consent[hidden] {
    display: none;
  }
  .consent-inner {
    display: grid;
    gap: var(--space-3);
  }
  .consent-title {
    font-size: var(--fs-15);
    letter-spacing: 0;
  }
  .consent-text {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .consent-text a {
    color: var(--color-navy-800);
  }
  .consent-actions {
    display: flex;
    gap: var(--space-2);
    justify-content: flex-end;
  }
  @media (min-width: 640px) {
    .consent {
      left: auto;
    }
  }
</style>
