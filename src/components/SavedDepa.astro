---
// Plantilla de un inmueble guardado en "Mis inmuebles". La página la clona y la completa en el
// navegador con los datos de /data/properties.json (solo los inmuebles que la persona guardó).
import HouseIcon from './HouseIcon.astro'
import Icon from './Icon.astro'
---

<template data-saved-template>
  <article class="saved-depa">
    <div class="saved-image">
      <img data-slot="image" alt="" loading="lazy" decoding="async" hidden />
      <span class="saved-placeholder" data-slot="placeholder">
        <HouseIcon />
      </span>
    </div>
    <div class="saved-content">
      <div class="saved-title-row">
        <h3 class="display">
          <a data-slot="link"></a>
        </h3>
        <button class="remove-depa" type="button" data-slot="remove">
          <Icon name="x" size={16} />
          Eliminar
        </button>
      </div>
      <p class="saved-place">
        <Icon name="pin" size={16} /> <span data-slot="place"></span>
      </p>
      <p class="saved-facts" data-slot="facts"></p>
      <p class="saved-description" data-slot="description"></p>
      <p class="saved-price">
        <span data-slot="price-label">Desde</span> <strong data-slot="price"></strong>
      </p>
    </div>
  </article>
</template>

<!-- Íconos que el script copia junto a cada dato (dorm., baños, m², rentabilidad, plazo) -->
<div hidden data-fact-icons>
  <span data-fact-icon="bed">
    <Icon name="bed" size={18} />
  </span>
  <span data-fact-icon="bath">
    <Icon name="bath" size={18} />
  </span>
  <span data-fact-icon="area">
    <Icon name="area" size={18} />
  </span>
  <span data-fact-icon="trend">
    <Icon name="trend" size={18} />
  </span>
  <span data-fact-icon="calendar">
    <Icon name="calendar" size={18} />
  </span>
</div>

<style>
  .saved-depa {
    display: grid;
    grid-template-columns: minmax(112px, 34%) minmax(0, 1fr);
    gap: var(--space-5);
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
  }
  .saved-image {
    position: relative;
    align-self: stretch;
    min-height: 168px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-navy-50);
  }
  .saved-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .saved-image img[hidden],
  .saved-placeholder[hidden] {
    display: none;
  }
  .saved-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--color-navy-800);
  }
  .saved-placeholder :global(svg) {
    width: 48px;
    height: 48px;
  }
  .saved-content {
    display: grid;
    align-content: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .saved-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  h3 {
    font-size: 1.625rem;
    color: var(--color-navy-800);
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .remove-depa {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 4px;
    min-height: var(--control-h-sm);
    padding: 0 var(--space-3);
    font-size: var(--fs-sm);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .remove-depa:hover {
    background: var(--color-navy-50);
    color: var(--color-navy-800);
  }
  .saved-place {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    color: var(--color-text-muted);
  }
  .saved-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-text);
  }
  .saved-facts :global(span) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .saved-description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
  .saved-description:empty {
    display: none;
  }
  .saved-price {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-15);
  }
  .saved-price strong {
    margin-left: var(--space-1);
    color: var(--color-navy-800);
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 480px) {
    .saved-depa {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .saved-image {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }
</style>
