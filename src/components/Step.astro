---
// Un paso del "Cómo funciona". Va dentro de un <ol> (la lista ya numera para lectores de pantalla)
const { number, title, text } = Astro.props
---
<li class="step">
  <span class="number" aria-hidden="true">{number}</span>
  <div>
    <h3>{title}</h3>
    <p>{text}</p>
  </div>
</li>

<style>
  /* Móvil: pasos en vertical, círculo a la izquierda */
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }
  .step:last-child { padding-bottom: 0; }

  /* Línea que une los círculos (decorativa) */
  .step::before {
    content: '';
    position: absolute;
    top: 32px;
    bottom: 0;
    left: 15px;
    width: 2px;
    background: var(--color-border);
  }
  .step:last-child::before { display: none; }

  .number {
    position: relative; /* queda encima de la línea */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background: var(--color-navy-800);
    color: #fff;
    font-weight: var(--fw-bold);
  }

  h3 { font-size: 1.125rem; font-weight: var(--fw-semibold); }
  p { margin: var(--space-1) 0 0; font-size: 0.9375rem; color: var(--color-text-muted); }

  /* Desde 640px: pasos en horizontal, todo centrado */
  @media (min-width: 640px) {
    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      padding: 0 var(--space-2);
      text-align: center;
    }
    .step::before {
      top: 19px;
      bottom: auto;
      left: 50%;
      width: 100%;
      height: 2px;
    }
    .number { width: 40px; height: 40px; }
    p { max-width: 18ch; margin-inline: auto; }
  }
</style>
