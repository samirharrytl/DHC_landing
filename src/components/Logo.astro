---
// Logo de texto con una casita. inverse = versión blanca (para fondos navy).
// TODO: cuando exista el SVG oficial del logo, reemplazar este contenido.
const { inverse = false } = Astro.props
---
<a href="/" class:list={['logo', { inverse }]} aria-label="Depa Host Perú, ir al inicio">
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 15 16 5l12 10" />
    <path d="M8 13v14h16V13" />
    <path d="M12.5 20.5a5 5 0 0 1 7 0" />
    <circle cx="16" cy="23.5" r="0.8" fill="currentColor" />
  </svg>
  <span>Depa Host Perú</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h-sm);
    color: var(--color-navy-800);
    font-weight: var(--fw-bold);
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo.inverse { color: #fff; }

  /* Alto del ícono: 32 móvil · 36 tablet · 44 desktop */
  svg { width: 32px; height: 32px; flex: none; }
  @media (min-width: 640px) { svg { width: 36px; height: 36px; } }
  @media (min-width: 1024px) { svg { width: 44px; height: 44px; } .logo { font-size: 1.25rem; } }
</style>
