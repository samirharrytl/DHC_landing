---
// Identidad de DepaHost Capital: los dos techos arriba y el nombre en versalitas debajo.
// Vectorizado de src/assets/logo depa.svg (dorado sobre navy) y logo depa blanco.svg (navy sobre blanco).
// inverse: techos dorados y texto claro, para fondos navy.
interface Props {
  inverse?: boolean
}
const { inverse = false } = Astro.props
// Cada logo de la página necesita su propio id de degradado
const gradientId = `logo-gold-${Math.random().toString(36).slice(2, 8)}`
---

<a href="/" class:list={['logo', { inverse }]} aria-label="DepaHost Capital, ir al inicio">
  <svg class="logo-mark" viewBox="396 300 496 244" aria-hidden="true">
    {inverse && (
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#a87528" />
          <stop offset="0.45" stop-color="#e0b158" />
          <stop offset="1" stop-color="#b07d2c" />
        </linearGradient>
      </defs>
    )}
    <g fill={inverse ? `url(#${gradientId})` : 'currentColor'}>
      <path d="M400 540V435l189-129 87 61-45 30-47-32-138 92v83Z" />
      <path d="M557 540v-83l187-120 144 98v105h-47v-83l-101-68-136 88v63Z" />
    </g>
  </svg>
  <span class="logo-name">DepaHost Capital</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: var(--control-h-sm);
    color: var(--color-navy-800);
    text-decoration: none;
    white-space: nowrap;
  }
  .logo-mark {
    width: 64px;
    height: auto;
    flex: none;
  }
  .logo-name {
    color: var(--color-navy-800);
    font: 600 16px/1 var(--font-sans);
    font-variant-caps: small-caps;
    letter-spacing: 0.06em;
  }
  .logo.inverse .logo-name {
    color: #f4efe6;
  }

  @media (max-width: 420px) {
    .logo-mark {
      width: 52px;
    }
    .logo-name {
      font-size: 14px;
    }
  }
</style>
