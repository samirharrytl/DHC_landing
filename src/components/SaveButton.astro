---
// Botón "Me interesa": agrega o quita un inmueble de Mis inmuebles (lógica en src/scripts/saved-buttons.ts).
// variant: 'cta' (dorado, como "Agregar al carrito": tarjetas y detalle) | 'outline' | 'solid' (proyectos de inmobiliarias)
import Icon from './Icon.astro'

interface Props {
  id: string
  name: string
  variant?: 'cta' | 'outline' | 'solid'
  class?: string
}
const { id, name, variant = 'cta', class: className } = Astro.props
---

<button
  class:list={[
    'btn btn--sm save-button',
    { solid: 'btn--primary', outline: 'btn--secondary', cta: 'btn--cta' }[variant],
    `save-button--${variant}`,
    className,
  ]}
  type="button"
  data-add-property
  data-property-id={id}
  data-property-name={name}
  aria-pressed="false"
  aria-label={`Me interesa: agregar ${name} a Mis inmuebles`}
>
  <Icon name="heart" size={18} class="heart" />
  <span data-save-label>Me interesa</span>
</button>

<script>
  import '../scripts/saved-buttons'
</script>

<style>
  .save-button :global(.heart) {
    transition:
      fill var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .save-button[aria-pressed='true'] :global(.heart) {
    fill: currentColor;
  }
  .save-button--outline[aria-pressed='true'] {
    background: var(--color-navy-50);
  }
  .save-button--solid[aria-pressed='true'] {
    background: var(--color-navy-950);
  }
  /* Ya está en Mis inmuebles: dorado suave, para que se note que el clic lo quita */
  .save-button--cta[aria-pressed='true'] {
    background: var(--color-gold-100);
    border-color: var(--color-gold-700);
  }
  @media (prefers-reduced-motion: no-preference) {
    .save-button[aria-pressed='true'] :global(.heart) {
      animation: beat var(--dur-slow) var(--ease-out);
    }
  }
  @keyframes beat {
    50% {
      transform: scale(1.25);
    }
  }
</style>
