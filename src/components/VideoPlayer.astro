---
// Video de un depa dentro de la galería. Archivo (.mp4/.webm): <video> nativo.
// YouTube o Vimeo: primero una portada con botón de reproducir; el reproductor se inserta al tocarla
// (lógica en src/scripts/video.ts), así no se cargan sus scripts ni cookies antes de tiempo.
import Icon from './Icon.astro'
import { parseVideo } from '../lib/media'

interface Props {
  url: string
  title: string
  /** Imagen de portada (URL ya optimizada) */
  poster?: string
}
const { url, title, poster } = Astro.props
const source = parseVideo(url)
---

{source.kind === 'file' ? (
  <video class="video-file" controls playsinline preload="none" poster={poster} aria-label={title}>
    <source src={url} type={url.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
    Tu navegador no puede reproducir este video.
  </video>
) : (
  <div class="video-embed">
    <button
      type="button"
      class="video-facade"
      data-embed-src={source.embedUrl}
      data-embed-title={title}
      aria-label={`Reproducir video: ${title}`}
    >
      {poster && <img src={poster} alt="" loading="lazy" decoding="async" />}
      <span class="video-play">
        <Icon name="play" size={30} strokeWidth={2} />
      </span>
      <span class="video-title">{title}</span>
    </button>
  </div>
)}

<script>
  import '../scripts/video'
</script>

<style>
  .video-file,
  .video-embed {
    display: block;
    width: 100%;
    height: 100%;
    background: #000;
  }
  .video-file {
    object-fit: contain;
  }
  .video-embed :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-facade {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
  }
  .video-facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
  }
  .video-play {
    position: relative;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-pill);
    background: var(--color-gold-500);
    color: var(--color-navy-900);
    box-shadow: var(--shadow-lg);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .video-play :global(svg) {
    fill: currentColor;
  }
  .video-facade:hover .video-play {
    transform: scale(1.06);
  }
  .video-title {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: rgb(3 26 57 / 0.72);
    color: #fff;
    font-size: var(--fs-13);
  }
</style>
