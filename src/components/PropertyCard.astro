---
// Tarjeta de depa reutilizable (Capital y home). Toda la tarjeta lleva al detalle del depa.
import type { Property } from '../types/property'
import { formatPEN, formatYears, formatYield } from '../lib/format'
import { buildSearchText } from '../lib/filters'
import HouseIcon from './HouseIcon.astro'
import PropertyImage from './PropertyImage.astro'
import SaveButton from './SaveButton.astro'

interface Props {
  property: Property
  /** Solo las primeras tarjetas visibles: carga la foto con prioridad (mejora el LCP) */
  priority?: boolean
}

const { property: p, priority = false } = Astro.props
const href = `/capital/${p.slug}`
const image = p.images[0]
---

<article
  class="card"
  data-property-card
  data-search={buildSearchText(p)}
  data-district={p.district.slug}
  data-price={p.price.amount}
  data-yield-min={p.yield.min}
>
  <!-- Imagen 16:9. Mientras no hay foto, se muestra un bloque con una casita -->
  <div class="media">
    {image ? (
      <PropertyImage
        image={image}
        widths={[480, 640, 960]}
        sizes="(max-width: 640px) 85vw, (max-width: 1024px) 50vw, 33vw"
        priority={priority}
      />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <HouseIcon />
      </div>
    )}
    <div class="tags">
      <span class="tag">{p.origin === 'developer' ? 'De proyecto' : 'De propietario'}</span>
      {p.status === 'reserved' ? (
        <span class="tag tag--light">Reservado</span>
      ) : (
        p.badge && <span class="tag tag--light">{p.badge}</span>
      )}
    </div>
  </div>

  <div class="body">
    <h3 class="title display">
      <!-- Este link cubre toda la tarjeta (ver a::after en el CSS) -->
      <a href={href} data-astro-prefetch>
        {p.district.name}
      </a>
    </h3>
    <p class="address">{p.address}</p>
    <dl class="stats">
      <div class="stat">
        <dt>valor</dt>
        <dd>{formatPEN(p.price.amount)}</dd>
      </div>
      <div class="stat">
        <dt>rentabilidad</dt>
        <dd>{formatYield(p.yield)}</dd>
      </div>
      <div class="stat">
        <dt>se paga en</dt>
        <dd>{formatYears(p.paybackYears)}</dd>
      </div>
    </dl>
  </div>

  <div class="footer-actions">
    <SaveButton id={p.id} name={p.district.name} />
    <a class="btn btn--secondary btn--sm" href={href}>
      Ver más detalle
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    container-type: inline-size; /* para achicar los números si la tarjeta es angosta */
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
  /* lo oculta el buscador cuando la tarjeta no coincide */
  .card[hidden] {
    display: none;
  }
  /* El anillo de foco va en toda la tarjeta cuando el foco está en el título
     (los botones de abajo conservan su propio anillo) */
  .card:has(.title a:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  /* ---------- Imagen 16:9 ---------- */
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-border-subtle);
  }
  .media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .card:hover .media :global(img) {
    transform: scale(1.03);
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: linear-gradient(135deg, var(--color-navy-50), var(--color-navy-100));
    color: var(--color-navy-800);
  }
  /* :global porque el svg viene del componente HouseIcon */
  .placeholder :global(svg) {
    width: 48px;
    height: 48px;
    opacity: 0.35;
  }

  .tags {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .tag {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-navy-800);
    color: var(--color-text-inverse);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    line-height: 1.4;
  }
  .tag--light {
    background: rgb(255 255 255 / 0.92);
    color: var(--color-navy-800);
  }

  /* ---------- Cuerpo ---------- */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
    padding: var(--space-4);
  }
  @media (min-width: 1024px) {
    .body {
      padding: var(--space-5);
    }
  }

  .title {
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  } /* link que cubre la tarjeta */
  .title a:focus-visible {
    box-shadow: none;
  }

  .address {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: var(--space-4) 0 0;
  }
  .stat {
    min-width: 0;
  }
  .stat + .stat {
    border-left: var(--border-subtle);
    padding-left: var(--space-3);
  }
  dt {
    font-size: var(--fs-13);
    color: var(--color-text-muted);
  }
  dd {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-stat);
    font-weight: var(--fw-semibold);
    color: var(--color-text-strong);
    font-variant-numeric: tabular-nums;
  }
  @container (max-width: 300px) {
    dd {
      font-size: var(--fs-15);
    }
  }

  /* ---------- Botones de acción ---------- */
  .footer-actions {
    position: relative;
    z-index: 1; /* encima del link que cubre toda la tarjeta */
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-3);
    border-top: var(--border-subtle);
  }
  .footer-actions > :global(*) {
    flex: 1;
    min-width: 0;
    padding-inline: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:hover .media :global(img) {
      transform: none;
    }
  }
</style>
