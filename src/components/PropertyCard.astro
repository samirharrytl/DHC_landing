---
// Tarjeta de inmueble reutilizable (Capital y home). Toda la tarjeta lleva al detalle del inmueble.
import type { Property } from '../types/property'
import { propertyFacts } from '../lib/facts'
import { formatPEN, streetOf } from '../lib/format'
import { buildSearchText } from '../lib/filters'
import { depaPosition } from '../lib/geo'
import FactRow from './FactRow.astro'
import HouseIcon from './HouseIcon.astro'
import Icon from './Icon.astro'
import PropertyImage from './PropertyImage.astro'
import SaveButton from './SaveButton.astro'

interface Props {
  property: Property
  /** Solo las primeras tarjetas visibles: carga la foto con prioridad (mejora el LCP) */
  priority?: boolean
}

const { property: p, priority = false } = Astro.props
const href = `/capital/${p.slug}`
const image = p.images[0]
// Lo que resalta es la calle (sin la cuadra); debajo va el distrito
const street = streetOf(p.address)
// Para "Cerca de" en Todos los inmuebles: la ubicación exacta o el centro del distrito
const position = depaPosition(p)
// Lo que más mira la gente al comparar: dormitorios y baños, área y antigüedad
const facts = propertyFacts(p)
---

<article
  class="card"
  data-property-card
  data-search={buildSearchText(p)}
  data-district={p.district.slug}
  data-price={p.price.amount}
  data-yield-min={p.yield?.min ?? 0}
  data-yield-max={p.yield?.max ?? 0}
  data-origin={p.origin}
  data-developer={p.developer?.slug}
  data-payback={p.paybackYears ?? 'Infinity'}
  data-status={p.status}
  data-id={p.id}
  data-lat={position?.lat}
  data-lng={position?.lng}
  data-exact={position?.exact ? '' : undefined}
>
  <!-- Imagen 16:9. Mientras no hay foto, se muestra un bloque con una casita -->
  <div class="media">
    {image ? (
      <PropertyImage
        image={image}
        widths={[480, 640, 960]}
        sizes="(max-width: 640px) 85vw, (max-width: 1024px) 50vw, 33vw"
        priority={priority}
      />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <HouseIcon />
      </div>
    )}
    <div class="tags">
      <span class="tag">{p.origin === 'developer' ? 'De proyecto' : 'De propietario'}</span>
      {p.status === 'reserved' ? (
        <span class="tag tag--light">Reservado</span>
      ) : (
        p.badge && <span class="tag tag--deal">{p.badge}</span>
      )}
    </div>
  </div>

  <div class="body">
    <!-- Calle y precio en la misma línea; debajo, el distrito y qué precio es -->
    <div class="head">
      <h3 class="title display">
        <!-- Este link cubre toda la tarjeta (ver a::after en el CSS) -->
        <a href={href} data-astro-prefetch>
          {street}
        </a>
      </h3>
      <p class="district">{p.district.name}</p>
      <p class="price">{formatPEN(p.price.amount)}</p>
      <p class="price-label">{p.origin === 'developer' ? 'Precio desde' : 'Precio'}</p>
    </div>
    <!-- "a 1.2 km de Larcomar": lo llena la búsqueda de Todos los inmuebles cuando se elige "Cerca de" -->
    <p class="distance" data-distance hidden>
      <Icon name="pin" size={16} />
      <span data-distance-text></span>
    </p>
    <!-- Al fondo del cuerpo: los datos quedan parejos en todas las tarjetas de una fila -->
    {facts.length > 0 && (
      <div class="facts">
        <FactRow facts={facts} label="Características" />
      </div>
    )}
  </div>

  <div class="footer-actions">
    <SaveButton id={p.id} name={`${street}, ${p.district.name}`} />
    <a class="btn btn--secondary btn--sm" href={href}>
      Ver más detalle
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    container-type: inline-size; /* para achicar los números si la tarjeta es angosta */
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
  /* lo oculta el buscador cuando la tarjeta no coincide */
  .card[hidden] {
    display: none;
  }
  /* El anillo de foco va en toda la tarjeta cuando el foco está en el título
     (los botones de abajo conservan su propio anillo) */
  .card:has(.title a:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  /* ---------- Imagen 16:9 ---------- */
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-border-subtle);
  }
  .media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .card:hover .media :global(img) {
    transform: scale(1.03);
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: linear-gradient(135deg, var(--color-navy-50), var(--color-navy-100));
    color: var(--color-navy-800);
  }
  /* :global porque el svg viene del componente HouseIcon */
  .placeholder :global(svg) {
    width: 48px;
    height: 48px;
    opacity: 0.35;
  }

  .tags {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .tag {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-navy-800);
    color: var(--color-text-inverse);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    line-height: 1.4;
  }
  .tag--light {
    background: rgb(255 255 255 / 0.92);
    color: var(--color-navy-800);
  }
  /* "Súper precio", "Últimos en venta": insignia de oferta */
  .tag--deal {
    background: var(--color-deal);
  }

  /* ---------- Cuerpo ---------- */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: var(--space-4);
  }
  @media (min-width: 1024px) {
    .body {
      padding: var(--space-5);
    }
  }

  /* Dos filas alineadas: calle | precio, distrito | "Precio" */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title price'
      'district label';
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }
  .head p {
    margin: 0;
  }
  .title {
    grid-area: title;
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  } /* link que cubre la tarjeta */
  .title a:focus-visible {
    box-shadow: none;
  }
  .district {
    grid-area: district;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .price {
    grid-area: price;
    font-size: var(--fs-stat);
    font-weight: var(--fw-bold);
    line-height: 1.15;
    color: var(--color-text-strong);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .price-label {
    grid-area: label;
    font-size: var(--fs-13);
    color: var(--color-text-muted);
    text-align: right;
  }

  .distance {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    color: var(--color-navy-800);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .distance[hidden] {
    display: none;
  }
  .distance :global(svg) {
    flex: none;
  }

  .facts {
    margin-top: auto;
  }
  @container (max-width: 320px) {
    .body {
      padding: var(--space-4);
    }
  }
  /* Tarjeta muy angosta (pantallas de 320px): el precio pasa debajo del distrito */
  @container (max-width: 260px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'title' 'district' 'price' 'label';
    }
    .price,
    .price-label {
      text-align: left;
    }
    .price {
      margin-top: var(--space-2);
    }
  }

  /* ---------- Botones de acción ---------- */
  .footer-actions {
    position: relative;
    z-index: 1; /* encima del link que cubre toda la tarjeta */
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-3);
    border-top: var(--border-subtle);
  }
  .footer-actions > :global(*) {
    flex: 1;
    min-width: 0;
    padding-inline: var(--space-3);
  }
  /* Tarjeta muy angosta (carrusel en pantallas de 320px): que "Ver más detalle" entre en el botón */
  @container (max-width: 260px) {
    .footer-actions {
      padding-inline: var(--space-2);
    }
    .footer-actions > :global(*) {
      padding-inline: var(--space-2);
      font-size: var(--fs-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:hover .media :global(img) {
      transform: none;
    }
  }
</style>
