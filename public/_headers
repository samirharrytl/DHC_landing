# Cabeceras del sitio en Cloudflare (Workers con archivos estáticos; se copia tal cual a dist/).

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Archivos con hash en el nombre (JS, CSS, fuentes e imágenes optimizadas): cambian de nombre en cada build
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Las URLs *.workers.dev no se indexan: el sitio se encuentra solo en depahostperu.com
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
