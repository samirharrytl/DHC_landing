{
  "name": "depahostcapital",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:preprod": "astro build --mode preprod",
    "preprod": "astro build --mode preprod && astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:types": "openapi-typescript openapi/depahost-api.json -o src/lib/api/schema.d.ts",
    "api:mock": "prism mock openapi/depahost-api.json --port 4010 --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@sentry/browser": "^11.8.0",
    "astro": "^7.3.7",
    "openapi-fetch": "^0.17.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "@stoplight/prism-cli": "^5.16.0",
    "happy-dom": "^21.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
