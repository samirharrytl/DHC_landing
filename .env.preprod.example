# Preproducción local: build de producción que lee el catálogo del API, igual que el sitio publicado.
# Copia este archivo como .env.preprod y corre `pnpm preprod` (build + vista previa en
# http://localhost:4321). Antes, en el panel de DepaHost: `npm run dev` (API en http://localhost:3000/api).

PUBLIC_WHATSAPP_NUMBER=51XXXXXXXXX
PUBLIC_CLARITY_ID=
PUBLIC_API_URL=http://localhost:3000/api
# El build lee los inmuebles del panel; inmobiliarias, sus proyectos y supuestos salen de src/content
API_URL=http://localhost:3000/api
# Panel en vite preview
PUBLIC_PANEL_URL=http://localhost:4173
PUBLIC_LOGIN_ENABLED=false
# Clave de prueba: muestra el widget y siempre pasa
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_SENTRY_DSN=
# Dominio de Supabase del panel (sin https://), para optimizar sus fotos
PUBLIC_MEDIA_HOST=
