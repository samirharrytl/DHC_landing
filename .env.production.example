# Producción. Estas variables van en Cloudflare: Workers & Pages → el Worker del sitio → Settings →
# Build → Variables and secrets, no en un archivo del repo. Reemplaza los valores entre <>.
# Sin API_URL o PUBLIC_MEDIA_HOST el build de Cloudflare falla a propósito (astro.config.mjs).

# Versión de pnpm del build (sin ella Cloudflare usa otra)
PNPM_VERSION=11.24.0

PUBLIC_WHATSAPP_NUMBER=<51 y el número, sin + ni espacios>
PUBLIC_CLARITY_ID=yussnspsw6
# El panel de DepaHost es el backend: su dominio + /api
PUBLIC_API_URL=https://<dominio del panel>/api
API_URL=https://<dominio del panel>/api
# Cloudflare → Turnstile → tu widget → Site key
PUBLIC_TURNSTILE_SITE_KEY=<site key de Turnstile>
PUBLIC_SENTRY_DSN=
# Dominio de Supabase del panel, de donde vienen las fotos (Project Settings → API → Project URL, sin https://)
PUBLIC_MEDIA_HOST=<proyecto>.supabase.co
