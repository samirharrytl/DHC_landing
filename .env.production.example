# Producción. Estas variables van en el panel del hosting del sitio (Cloudflare Pages, Vercel o
# Netlify), no en un archivo del repo. Reemplaza los valores entre <>.

PUBLIC_WHATSAPP_NUMBER=<51 y el número, sin + ni espacios>
PUBLIC_CLARITY_ID=yussnspsw6
PUBLIC_API_URL=https://api.depahostperu.com
API_URL=https://api.depahostperu.com
PUBLIC_PANEL_URL=https://app.depahostperu.com
# Cloudflare → Turnstile → tu widget → Site key
PUBLIC_TURNSTILE_SITE_KEY=<site key de Turnstile>
PUBLIC_SENTRY_DSN=
# Solo si las fotos de R2 usan un dominio propio (ej. media.depahostperu.com). *.r2.dev ya está permitido.
PUBLIC_MEDIA_HOST=
